def _dim(c, f):
    """Return a darkened version of a hex colour."""
    h = c.lstrip("#"); r, g, b = int(h[0:2],16), int(h[2:4],16), int(h[4:6],16)
    return "#%02x%02x%02x" % (int(r*f), int(g*f), int(b*f))

def _light(c, a):
    """Return a lightened version of a hex colour."""
    h = c.lstrip("#"); r, g, b = int(h[0:2],16), int(h[2:4],16), int(h[4:6],16)
    r = min(255, int(r + (255-r)*a)); g = min(255, int(g + (255-g)*a))
    b = min(255, int(b + (255-b)*a))
    return "#%02x%02x%02x" % (r, g, b)

