def extract_hooks(text):
    """Return a list of topics matched from the user's message."""
    words = re.findall(r"[a-z]+", text.lower())
    hooks = []
    seen = set()
    for w in words:
        if w in HOOK_MAP:
            topic = HOOK_MAP[w]
            if topic not in seen:
                hooks.append(topic)
                seen.add(topic)
    return hooks

def extract_topic(text):
    """Legacy: return the raw keywords for topic display."""
    words = [w for w in re.findall(r"[a-z]+", text.lower()) if w not in STOPWORDS and len(w) > 2]
    return " ".join(words[:3]) if words else ""

def extract_topic_words(text):
    """Return a list of non-stopword tokens."""
    return [w for w in re.findall(r"[a-z]+", text.lower()) if w not in STOPWORDS and len(w) > 2]

def _fmt(s, topic):
    """Safe format: replace {topic} or fall back."""
    if not s: return ""
    try: return s.replace("{topic}", topic or "that")
    except Exception: return s

def try_math(text):
    """Detect simple arithmetic expressions."""
    t = text.lower().strip().rstrip("?=.")
    cleaned = re.sub(r"[^0-9\+\-\*/\.\(\)\s]", "", t)
    if not cleaned.strip() or not re.search(r"[\+\-\*/]", cleaned): return None
    try:
        r = eval(cleaned, {"__builtins__": {}}, {})
        if isinstance(r, (int, float)):
            if isinstance(r, float) and r.is_integer(): r = int(r)
            return str(r)
    except Exception: pass
    return None

