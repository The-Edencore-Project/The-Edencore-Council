IDLE = {"last": 0.0}

def idle_remark():
    seat = random.choice(NAMES)
    if seat == "Ripple":
        fact = ripple_fact()
        if fact:
            typewriter(seat, "\u273f " + fact, delay=50)
            glow_ritual(seat, True)
            root.after(700, lambda: glow_ritual(seat, False))
            return
    line = POOLS["tired"][seat] if COUNCIL.seats[seat].overwhelmed else POOLS["idle"][seat]
    entry_line = random.choice(_as_list(line))
    typewriter(seat, "\u263d " + entry_line, delay=50)
    glow_ritual(seat, True)
    root.after(700, lambda: glow_ritual(seat, False))

def heartbeat():
    # Recover stamina, decay strain
    for b in COUNCIL.seats.values(): b.rest(1.0)
    COUNCIL.rapport = min(1.0, MEMORY.msgs/200.0 + len(MEMORY.days)/30.0)
    update_ex(); poll_bat()
    now = time.time()
    if now - COUNCIL.last_save > 30:
        COUNCIL.save(); COUNCIL.last_save = now

    # Watchdog: if a discussion has been running more than 60s, release the lock
    if IN_DISCUSSION[0] and (now - LAST_DISCUSSION_START[0] > 60):
        IN_DISCUSSION[0] = False
        add_system("\u2696 Solon - The council session timed out. The floor is open.")

    # Idle remarks if the user has been quiet
    if (now - EXTERO.activity > 45 and now - IDLE["last"] > 60
            and not IN_DISCUSSION[0] and entry.get().strip() == ""):
        idle_remark(); IDLE["last"] = now

    root.after(1000, heartbeat)

