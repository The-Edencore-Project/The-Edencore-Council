def _as_list(x):
    if isinstance(x, str): return [x]
    return list(x)

# =====================================================================
# KNOWLEDGE ENGINE: PHRASE SELECTION WITH WEIGHTING
# =====================================================================

def select_phrase(seat, hooks, tone="neutral"):
    """Weighted selection from TOPIC_MATRIX based on hooks and tone."""
    if not hooks:
        return None, None
    # Weight each hook equally for now
    topic = random.choice(hooks) if hooks else None
    if topic and topic in TOPIC_MATRIX:
        pool = TOPIC_MATRIX[topic].get(seat, [])
        if pool:
            return random.choice(pool), topic
    return None, None

def select_fact(topic, chance=0.20):
    """Return a random fact for the topic with the given probability."""
    if random.random() > chance: return None
    if topic and topic in FACTS_DB:
        pool = FACTS_DB[topic]
        if pool: return random.choice(pool)
    return None

def color_fact_with_personality(fact, seat):
    """Use SEMANTIC_LINKS to add personality to a fact."""
    # Find keywords in the fact
    words = re.findall(r"[a-z]+", fact.lower())
    linked = []
    for w in words:
        if w in SEMANTIC_LINKS:
            linked.extend(SEMANTIC_LINKS[w])
    if not linked: return fact
    flavour = random.choice(linked)
    suffix = {
        "Solon": " Note the risk in that.",
        "Lumen": " What does that mean?",
        "Vertex": " A system worth studying.",
        "Prism": " The pattern is clear.",
        "Ripple": " Imagine how that must feel.",
    }.get(seat, "")
    return fact + suffix

# =====================================================================
# PROVIDER ENGINE: SEAT REPLY
# =====================================================================

def seat_reply(seat, kind, question, topic):
    if COUNCIL.seats[seat].overwhelmed:
        return random.choice(_as_list(POOLS["tired"][seat]))

    # Explicit council question
    if kind == "council":
        pool = POOLS["council"].get(seat, "Noted.")
        return _fmt(random.choice(_as_list(pool)), topic or "that")

    # System diagnostic
    if kind == "sys_check":
        if seat == "Solon":
            m = WORKING_MODEL[0] or CONFIG["tiers"]["frontier"].get("model") or "auto"
            if gemini_on():
                return "\u2696 The channel is open. Current model: " + m + "."
            else:
                return "\u2020 The channel is severed. Prism holds the archive."
        return random.choice(["Noted.", "Standing by.", "Listening."])

    # Determine which provider to use (weighted random from healthy chain)
    engine = select_provider(seat)

    # If the primary is Gemini and we have a key, try the LLM
    if engine == "gemini" and gemini_on() and kind not in ("greeting","greeting_morning",
                                                            "greeting_afternoon","greeting_evening",
                                                            "thanks","local","weather","math"):
        cache_key = (seat, question)
        if cache_key in REPLY_CACHE: return REPLY_CACHE[cache_key]
        r = gemini_for_seat(seat, question)
        if r and not r.startswith("[gemini error]"):
            REPLY_CACHE[cache_key] = r; return r
        # If Gemini failed, fall through to expert mode
        mark_provider_failed("gemini")

    # Expert mode: try TOPIC_MATRIX with hook weighting, then facts, then pools
    hooks = extract_hooks(question)
    phrase, matched_topic = select_phrase(seat, hooks)
    if phrase:
        # Chance to inject a fact instead
        fact = select_fact(matched_topic)
        if fact:
            return color_fact_with_personality(fact, seat)
        return phrase

    # Ripple's personal fact library
    if seat == "Ripple":
        fact = ripple_fact(extract_topic_words(question))
        if fact: return fact

    # Fall back to generic statement pool
    pool = POOLS.get(kind) or POOLS["statement"]
    entries = _as_list(pool.get(seat, "Noted."))
    return _fmt(random.choice(entries), topic or "that")

def expert_crosstalk(seat):
    if seat == "Ripple":
        fact = ripple_fact()
        if fact: return fact
    return random.choice(CROSSTALK.get(seat) or ["Noted."])

