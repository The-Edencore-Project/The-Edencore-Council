# =====================================================================
# STATE ENGINE: MOOD ANALYSIS
# =====================================================================

MOOD_POS = {"good","great","happy","love","wonderful","brilliant","amazing","joy","glad",
            "thanks","appreciate","kind","warm","calm","hopeful","excited","grateful",
            "nice","lovely","perfect","awesome","fun","smile"}
MOOD_NEG = {"bad","terrible","awful","hate","angry","sad","horrible","miserable","upset",
            "worried","anxious","scared","afraid","tired","exhausted","frustrated",
            "annoyed","hurt","pain","dark","lonely","broken","lost","confused","wrong",
            "fail","dying","dead","cry","depressed","stress","hopeless"}

def analyse_mood(text):
    ws = re.findall(r"[a-z']+", text.lower())
    p = sum(1 for w in ws if w in MOOD_POS)
    n = sum(1 for w in ws if w in MOOD_NEG)
    if p + n == 0: return 0.0
    return (p - n) / float(p + n)

def memory_callback():
    if PROFILE.level < 2: return
    top = PROFILE.top_theme()
    if not top: return
    if len(PROFILE.days_visited) < 2: return
    seat = random.choice(["Prism", "Lumen", "Ripple"])
    line = {
      "Prism": "\u262f You return to %s often. The pattern is forming." % top,
      "Lumen": "\u0950 We never finished %s. Shall we?" % top,
      "Ripple": "\u273f You have come back to %s. That matters." % top,
    }[seat]
    root.after(2500, lambda: (glow_ritual(seat, True), typewriter(seat, line, delay=45),
                               root.after(900, lambda: glow_ritual(seat, False))))

