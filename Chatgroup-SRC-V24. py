def draw_transformer(cv, cx, cy, size, colour, style, dim=False, glow=False):
    tag = "tform_" + str(cx)
    bw, bh, hr = size*0.75, size*1.0, size*0.30
    edge = DEEP if not dim else "#07080f"
    fill = colour if not dim else _dim(colour, 0.45)

    if style == "blocky":
        # Solon: hexagonal block
        cv.create_polygon(cx-bw*1.05, cy+bh, cx-bw*1.25, cy+bh*0.15, cx-bw*0.4, cy-bh*0.2,
                          cx+bw*0.4, cy-bh*0.2, cx+bw*1.25, cy+bh*0.15, cx+bw*1.05, cy+bh,
                          fill=fill, outline=edge, width=2, tags=tag)
    elif style == "soft":
        # Lumen: soft circle with inner orb
        cv.create_oval(cx-bw*0.85, cy-bh*0.2, cx+bw*0.85, cy+bh,
                       fill=fill, outline=edge, width=2, tags=tag)
        r = bw*0.28
        cv.create_oval(cx-r, cy+bh*0.32-r, cx+r, cy+bh*0.32+r,
                       fill=_light(colour, 0.4), outline=edge, tags=tag)
    elif style == "sharp":
        # Vertex: sharp triangle
        cv.create_polygon(cx, cy-bh*0.3, cx+bw*0.85, cy+bh*0.6, cx+bw*0.55, cy+bh,
                          cx-bw*0.55, cy+bh, cx-bw*0.85, cy+bh*0.6,
                          fill=fill, outline=edge, width=2, tags=tag)
    elif style == "faceted":
        # Prism: faceted diamond
        cv.create_polygon(cx, cy-bh*0.3, cx+bw*0.95, cy+bh*0.3, cx+bw*0.5, cy+bh,
                          cx-bw*0.5, cy+bh, cx-bw*0.95, cy+bh*0.3,
                          fill=fill, outline=edge, width=2, tags=tag)
    elif style == "flowy":
        # Ripple: flowing oval with side waves
        cv.create_oval(cx-bw*0.8, cy-bh*0.2, cx+bw*0.8, cy+bh,
                       fill=fill, outline=edge, width=2, tags=tag)
        cv.create_line(cx-bw*0.55, cy-bh*0.05,
                       cx-bw*1.15, cy+bh*0.20,
                       cx-bw*1.05, cy+bh*0.75,
                       fill=fill, width=2, smooth=True, tags=tag)
        cv.create_line(cx+bw*0.55, cy-bh*0.05,
                       cx+bw*1.15, cy+bh*0.20,
                       cx+bw*1.05, cy+bh*0.75,
                       fill=fill, width=2, smooth=True, tags=tag)

    # Head
    hcy = cy - bh*0.62
    cv.create_oval(cx-hr, hcy-hr, cx+hr, hcy+hr, fill=fill, outline=edge, width=2, tags=tag)

    # Eyes
    eye = "#ffffff" if glow else ("#3a3a4a" if dim else PARCH)
    ew, eh = hr*0.32, hr*0.20
    cv.create_oval(cx-hr*0.45-ew, hcy-eh, cx-hr*0.45+ew, hcy+eh, fill=eye, outline="", tags=tag)
    cv.create_oval(cx+hr*0.45-ew, hcy-eh, cx+hr*0.45+ew, hcy+eh, fill=eye, outline="", tags=tag)

