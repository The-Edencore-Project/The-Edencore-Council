def _jget(url, timeout=10, is_sparql=False):
    """JSON GET request with proper headers."""
    headers = {"User-Agent": "EdencoreCouncil/1.0"}
    if is_sparql: headers["Accept"] = "application/sparql-results+json"
    req = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read().decode("utf-8"))

def _clean(t): return re.sub(r"\s+", " ", t).strip()

WDPROPS = {"population":"P1082","capital":"P36","height":"P2048","elevation":"P2044",
           "founded":"P571","born":"P569","died":"P570","country":"P17",
           "continent":"P30","length":"P2043","diameter":"P2386","area":"P2046",
           "currency":"P38","language":"P37","owner":"P127","leader":"P35"}
WIKI_CACHE = {}

def wiki(query):
    """Look up a topic on Wikipedia. Returns {title, extract} or None."""
    if query in WIKI_CACHE: return WIKI_CACHE[query]
    try:
        u = "https://en.wikipedia.org/w/api.php?" + urllib.parse.urlencode(
            {"action":"query","list":"search","srsearch":query,"format":"json","srlimit":5})
        hits = _jget(u).get("query", {}).get("search", [])
        if not hits: WIKI_CACHE[query] = None; return None
        ql = query.lower().strip()
        title = next((h["title"] for h in hits if ql in h["title"].lower()), hits[0]["title"])
        e = "https://en.wikipedia.org/w/api.php?" + urllib.parse.urlencode(
            {"action":"query","prop":"extracts","exintro":1,"explaintext":1,
             "titles":title,"format":"json"})
        page = next(iter(_jget(e)["query"]["pages"].values()))
        ext = _clean(page.get("extract", ""))
        if not ext: WIKI_CACHE[query] = None; return None
        first = re.split(r"(?<=[.!?]) ", ext)[0]
        out = {"title": title, "extract": first}
        WIKI_CACHE[query] = out; return out
    except Exception:
        WIKI_CACHE[query] = None; return None

def _qid(title):
    """Get the Wikidata Q-ID for a Wikipedia title."""
    try:
        u = "https://en.wikipedia.org/w/api.php?" + urllib.parse.urlencode(
            {"action":"query","prop":"pageprops","titles":title,"format":"json"})
        page = next(iter(_jget(u)["query"]["pages"].values()))
        return page.get("pageprops", {}).get("wikibase_item")
    except Exception: return None

def _wdp(qid, prop):
    """Query a single property from Wikidata."""
    q = ("SELECT ?vLabel WHERE { wd:%s wdt:%s ?v. "
         "SERVICE wikibase:label { bd:serviceParam wikibase:language \"en\". } } LIMIT 1"
         % (qid, prop))
    u = "https://query.wikidata.org/sparql?" + urllib.parse.urlencode({"query": q, "format": "json"})
    try:
        d = _jget(u, 12, is_sparql=True)
        r = d.get("results", {}).get("bindings", [])
        return r[0].get("vLabel", {}).get("value") if r else None
    except Exception: return None

def wd(title, attr):
    """Get a specific attribute (e.g., population) from Wikidata."""
    q = _qid(title)
    if not q: return None
    p = WDPROPS.get(attr)
    return _wdp(q, p) if p else None

def detect_attribute(text):
    """Detect which Wikidata attribute the user is asking about."""
    q = text.lower()
    for a in WDPROPS:
        if re.search(r"\b" + re.escape(a) + r"\b", q): return a
    return None

WCODE = {0:"clear",1:"mainly clear",2:"partly cloudy",3:"overcast",45:"foggy",
         51:"drizzle",53:"drizzle",55:"heavy drizzle",61:"light rain",63:"rain",
         65:"heavy rain",71:"light snow",73:"snow",75:"heavy snow",80:"showers",
         95:"thunderstorm",96:"thunderstorm"}
WEATHER_CACHE = {"at": 0, "loc": None, "data": None}

def weather(loc):
    """Fetch current weather + 2-day forecast from Open-Meteo."""
    now = time.time()
    if WEATHER_CACHE["data"] and (now - WEATHER_CACHE["at"]) < 600 and WEATHER_CACHE["loc"] == loc:
        return WEATHER_CACHE["data"]
    try:
        loc = loc or "London"
        g = _jget("https://geocoding-api.open-meteo.com/v1/search?" + urllib.parse.urlencode(
            {"name":loc,"count":1,"language":"en","format":"json"}), 8)
        r = g.get("results", [])
        if not r: return None
        p = r[0]
        w = _jget("https://api.open-meteo.com/v1/forecast?" + urllib.parse.urlencode(
            {"latitude":p["latitude"],"longitude":p["longitude"],
             "current":"temperature_2m,weather_code,wind_speed_10m",
             "daily":"temperature_2m_max,temperature_2m_min,precipitation_sum",
             "timezone":"auto","forecast_days":2}), 8)
        c = w.get("current", {}); d = w.get("daily", {})
        out = {"name":p.get("name",loc), "country":p.get("country",""),
               "temp":c.get("temperature_2m"), "wind":c.get("wind_speed_10m"),
               "code":c.get("weather_code"),
               "tmax":(d.get("temperature_2m_max") or [None])[0],
               "tmin":(d.get("temperature_2m_min") or [None])[0],
               "precip":(d.get("precipitation_sum") or [None])[0]}
        WEATHER_CACHE["at"] = now; WEATHER_CACHE["loc"] = loc; WEATHER_CACHE["data"] = out
        return out
    except Exception: return None

def weather_seat(seat, w):
    """Each seat responds to the weather in their own voice."""
    if not w: return None
    n = w["name"] + (", " + w["country"] if w.get("country") else "")
    desc = WCODE.get(w.get("code"), "unclear")
    t, ti, tx, wi, pr = w.get("temp"), w.get("tmin"), w.get("tmax"), w.get("wind"), w.get("precip")
    if seat == "Solon":
        risks = []
        if pr and pr > 1: risks.append("rain")
        if wi and wi > 25: risks.append("wind")
        if t is not None and t < 3: risks.append("cold")
        return ("Risk noted: %s." % " and ".join(risks)) if risks else ("No risk named. %s. Proceed." % desc)
    if seat == "Lumen": return "A %s day in %s. What does it invite?" % (desc, n)
    if seat == "Vertex":
        parts = []
        if ti is not None and tx is not None: parts.append("%d to %dC" % (ti, tx))
        if wi is not None: parts.append("%dkm/h" % wi)
        return ", ".join(parts) + " in " + n + "."
    if seat == "Prism": return "%s - %s. A readable pattern." % (n, desc)
    if seat == "Ripple":
        if t is not None and t < 5: return "Cold. Take a coat, and think of those outside."
        if pr and pr > 1: return "Bring an umbrella. Softly."
        return "Nothing harsh. Go gently."
    return None

