# =====================================================================
# STATE ENGINE: PROFILE
# Tracks the user, their preferences, their mood, their themes.
# Follows a strict consent ladder (Levels 0-4).
# =====================================================================

@dataclass
class Profile:
    version: int = PROFILE_VERSION
    level: int = 0
    consent_given: bool = False
    name: str = ""
    aliases: list = field(default_factory=list)
    first_seen: float = 0.0
    last_seen: float = 0.0
    sessions: int = 0
    days_visited: list = field(default_factory=list)
    themes: dict = field(default_factory=dict)
    tod_tally: dict = field(default_factory=lambda: {"morning":0,"afternoon":0,"evening":0,"night":0})
    msg_count: int = 0
    tone_tally: dict = field(default_factory=lambda: {"brief":0,"measured":0,"thinking":0,"long-form":0})
    questions_count: int = 0
    statements_count: int = 0
    mood_ema: float = 0.0
    mood_7day: list = field(default_factory=list)
    upset_count: int = 0
    happy_count: int = 0
    anxious_count: int = 0
    last_session_mins: float = 0.0
    session_start: float = 0.0
    session_log: list = field(default_factory=list)

    def save(self):
        try:
            with open(PROFILE_PATH, "w") as f: json.dump(asdict(self), f, indent=2)
        except Exception: pass

    def load(self):
        try:
            with open(PROFILE_PATH) as f: d = json.load(f)
        except Exception: return
        for k, v in d.items():
            if hasattr(self, k): setattr(self, k, v)

    def wipe_above_level(self):
        """When the user lowers their level, erase anything above the new limit."""
        if self.level < 4: self.session_log = []
        if self.level < 3:
            self.tod_tally = {"morning":0,"afternoon":0,"evening":0,"night":0}
            self.msg_count = 0; self.tone_tally = {"brief":0,"measured":0,"thinking":0,"long-form":0}
            self.questions_count = 0; self.statements_count = 0
            self.mood_ema = 0.0; self.mood_7day = []
            self.upset_count = 0; self.happy_count = 0; self.anxious_count = 0
            self.last_session_mins = 0.0
        if self.level < 2:
            self.first_seen = 0.0; self.last_seen = 0.0; self.sessions = 0
            self.days_visited = []; self.themes = {}
        if self.level < 1:
            self.name = ""; self.aliases = []

    def set_level(self, n):
        n = max(0, min(4, int(n)))
        self.level = n
        if n > 0: self.consent_given = True
        self.wipe_above_level(); self.save()

    def note_session_start(self):
        if self.level < 2: return
        now = time.time()
        if self.session_start and self.last_seen:
            mins = (self.last_seen - self.session_start) / 60.0
            if 0 < mins < 24*60:
                self.last_session_mins = (self.last_session_mins + mins)/2 if self.last_session_mins else mins
        self.session_start = now; self.last_seen = now
        if not self.first_seen: self.first_seen = now
        self.sessions += 1
        today = datetime.date.today().isoformat()
        if today not in self.days_visited:
            self.days_visited.append(today)
            if len(self.days_visited) > 366: self.days_visited = self.days_visited[-366:]
        if self.level >= 3:
            h = datetime.datetime.now().hour
            bucket = "night" if h < 5 or h >= 22 else ("morning" if h < 12 else ("afternoon" if h < 17 else "evening"))
            self.tod_tally[bucket] = self.tod_tally.get(bucket, 0) + 1
        self.save()

    def note_message(self, text, tone, topic, is_question):
        if self.level < 2: return
        if topic:
            t = topic.lower().strip()
            self.themes[t] = self.themes.get(t, 0) + 1
            if len(self.themes) > 200:
                self.themes = dict(sorted(self.themes.items(), key=lambda kv: -kv[1])[:100])
        if self.level >= 3:
            self.msg_count += 1
            if tone in self.tone_tally: self.tone_tally[tone] += 1
            if is_question: self.questions_count += 1
            else: self.statements_count += 1
        self.save()

    def note_mood(self, sent):
        if self.level < 3: return
        a = 0.25
        self.mood_ema = (1-a)*self.mood_ema + a*sent
        today = datetime.date.today().isoformat()
        if self.mood_7day and self.mood_7day[-1][0] == today:
            self.mood_7day[-1] = [today, (self.mood_7day[-1][1] + sent)/2.0]
        else:
            self.mood_7day.append([today, sent])
            if len(self.mood_7day) > 7: self.mood_7day = self.mood_7day[-7:]
        if sent < -0.5: self.upset_count += 1
        elif sent > 0.5: self.happy_count += 1
        self.save()

    def readback(self):
        if self.level == 0:
            return ["\u2696  Solon - You are unnamed. Nothing is stored about you.",
                    "     I hold no memory of you at all."]
        L = ["\u2696  Solon - reading from the record:",
             "     Level: %d of 4" % self.level]
        if self.name:
            L.append("     Name: " + self.name)
            if self.aliases: L.append("     Also known as: " + ", ".join(self.aliases))
        else:
            L.append("     Name: not given")
        if self.level >= 2:
            if self.first_seen:
                L.append("     First seen: " + datetime.datetime.fromtimestamp(self.first_seen).strftime("%Y-%m-%d"))
            if self.last_seen:
                L.append("     Last seen: " + datetime.datetime.fromtimestamp(self.last_seen).strftime("%Y-%m-%d %H:%M"))
            L.append("     Sessions: %d   Days known: %d" % (self.sessions, len(self.days_visited)))
            if self.themes:
                top = sorted(self.themes.items(), key=lambda kv: -kv[1])[:10]
                L.append("     Themes you return to: " + ", ".join("%s (%d)" % (k, v) for k, v in top))
        if self.level >= 3:
            L.append("     Messages: %d   Questions: %d   Statements: %d" % (
                self.msg_count, self.questions_count, self.statements_count))
            L.append("     Mood running average: %+.2f" % self.mood_ema)
            tod = ", ".join("%s %d" % (k, v) for k, v in self.tod_tally.items() if v)
            L.append("     You arrive most often in: " + (tod or "-"))
            L.append("     Upset / happy / anxious: %d / %d / %d" % (
                self.upset_count, self.happy_count, self.anxious_count))
            if self.last_session_mins:
                L.append("     Recent session length: ~%.1f min" % self.last_session_mins)
        if self.level >= 4 and self.session_log:
            L.append("     Recent sessions:")
            for entry in self.session_log[-5:]:
                L.append("       %s - %.0f min - %s" % (entry.get("date",""), entry.get("mins",0),
                                                       ", ".join(entry.get("topics", []))))
        L.append("     File: " + PROFILE_PATH)
        return L

    def forget_name(self):
        self.name = ""; self.aliases = []; self.save()

    def forget_everything(self):
        try: os.remove(PROFILE_PATH)
        except Exception: pass
        for k, v in Profile().__dict__.items(): setattr(self, k, v)

    def add_session_log_entry(self, topics):
        if self.level < 4: return
        entry = {"date": datetime.date.today().isoformat(),
                 "mins": round((time.time() - self.session_start) / 60.0, 1) if self.session_start else 0,
                 "topics": list(topics)[:3]}
        self.session_log.append(entry)
        if len(self.session_log) > 200: self.session_log = self.session_log[-200:]
        self.save()

    def top_theme(self):
        if not self.themes: return None
        k, v = max(self.themes.items(), key=lambda kv: kv[1])
        return k if v >= 2 else None


