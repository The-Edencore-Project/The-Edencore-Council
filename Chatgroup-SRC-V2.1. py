def classify(text):
    t = text.lower().strip().rstrip("?!.")
    if not t: return ("statement", text, None)
    if t in {"hi","hello","hey","yo","hiya","howdy","greetings"}: return ("greeting", text, None)
    for f, k in [("good morning","greeting_morning"),("good afternoon","greeting_afternoon"),("good evening","greeting_evening")]:
        if f in t: return (k, text, None)
    if t in {"thanks","thank you","thankyou","thx","cheers","ta"}: return ("thanks", text, None)
    if t in {"sorry","i'm sorry","im sorry","my apologies","apologies","my bad"}: return ("apology", text, None)
    if t in {"yes","yeah","yep","yup","ok","okay","sure","agreed"}: return ("thanks", text, None)
    for f in ("how are you","how're you","how is everyone","how's everyone","how are we all","you ok","you alright","how do you all feel"):
        if f in t: return ("howareyou", text, None)
    if t in {"what can you do","what do you do","help me","what can i ask"}: return ("capability", text, None)
    if t in {"i'm bored","im bored","i am bored","bored"}: return ("bored", text, None)
    if t in {"tell me a joke","say a joke","make me laugh","tell a joke"}: return ("joke", text, None)
    if t in {"say something","talk to me","speak to me","say anything"}: return ("saysomething", text, None)
    if any(w in t for w in ("thank you","that's kind","you're kind","lovely","you're lovely")): return ("compliment", text, None)

    # --- SYSTEM DIAGNOSTIC INTENT ---
    if any(w in t for w in ("gemini", "wikipedia", "api", "model", "status")) and any(w in t for w in ("working", "online", "connected", "status", "check")):
        return ("sys_check", text, None)

    # --- BROADENED TIME AND DATE INTENT ---
    if re.search(r"\b(time|clock)\b", t):
        city_match = re.search(r"\b(?:in|at)\s+([A-Za-z][A-Za-z\s\-']{1,30})", text, re.I)
        if city_match:
            city = city_match.group(1).strip()
            return ("local", "%s (local time) — %s" % (city, datetime.datetime.now().strftime("%H:%M")), None)
        return ("local", datetime.datetime.now().strftime("%H:%M"), None)
        
    if re.search(r"\b(date|day)\b", t) and re.search(r"\b(today|current|it|is)\b", t):
        return ("local", datetime.datetime.now().strftime("%A, %d %B %Y"), None)

    m = try_math(text)
    if m: return ("math", m, None)
    words = set(re.findall(r"[a-z]+", t))
    wl = t.split()
    if is_council_question(t, wl):
        if not (words & {"weather","forecast","temperature","rain","sunny"}):
            return ("council", text, None)
    if words & {"weather","forecast","temperature","rain","sunny","cold","hot","snow"}:
        mm = re.search(r"\b(?:in|for|at)\s+([A-Za-z][A-Za-z\s\-']{1,30}?)(?:\s*(?:\?|$|today|tomorrow|tonight))", text, re.I)
        return ("weather", mm.group(1).strip() if mm else None, None)
    if re.match(r"^(best|cheapest|fastest|top|worst|nicest)\s+\w+", t): return ("recommend", text, extract_topic(text))
    if re.search(r"\b(what|which)('s| is| are)? the (best|cheapest|fastest|top)\b", t): return ("recommend", text, extract_topic(text))
    if re.search(r"\bwhere (should|can|do) i\b", t): return ("recommend", text, extract_topic(text))
    if t.startswith("recommend ") or t.startswith("suggest "): return ("recommend", text, extract_topic(text))
    if any(w in {"discuss","next","plan"} for w in wl) and any(w in ("we","shall","us") for w in wl): return ("planning", text, extract_topic(text))
    if any(w in {"should","would","better","favourite"} for w in wl): return ("opinion", text, extract_topic(text))
    if any(w in {"what","who","where","when","why","how","which"} for w in wl):
        return ("fact", text, extract_query(text))
    return ("statement", text, extract_topic(text))

