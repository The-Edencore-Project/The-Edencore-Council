def try_math(text):
    t = text.lower().strip().rstrip("?=.")
    cleaned = re.sub(r"[^0-9\+\-\*/\.\(\)\s]", "", t)
    if not cleaned.strip() or not re.search(r"[\+\-\*/]", cleaned): return None
    try:
        r = eval(cleaned, {"__builtins__": {}}, {})
        if isinstance(r, (int, float)):
            if isinstance(r, float) and r.is_integer(): r = int(r)
            return str(r)
    except Exception: pass
    return None

NAME_PATTERNS = [r"\bmy name is\s+([A-Za-z][A-Za-z'\-]{1,20})",
                 r"\bcall me\s+([A-Za-z][A-Za-z'\-]{1,20})",
                 r"\bi am called\s+([A-Za-z][A-Za-z'\-]{1,20})"]
def detect_name(text):
    for pat in NAME_PATTERNS:
        m = re.search(pat, text, flags=re.I)
        if m:
            n = m.group(1).strip()
            if 2 <= len(n) <= 20:
                return n[0].upper() + n[1:].lower()
    return None

def detect_address(text):
    s = text.strip()
    if not s: return None, text
    low = s.lower()
    for n in NAMES:
        ln = n.lower()
        if low.startswith("@" + ln):
            r = s[len(n)+1:].strip(); return n, (r if r else text)
    for n in NAMES:
        ln = n.lower()
        for sep in (",", ":", " "):
            if low.startswith(ln + sep):
                r = s[len(n)+1:].strip()
                if r: return n, r
    bare = re.sub(r"[^a-z]", "", low)
    for n in NAMES:
        if bare == n.lower(): return n, ""
    return None, text

