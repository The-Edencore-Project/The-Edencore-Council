WIKI_CACHE = {}

def wiki(query):
    if query in WIKI_CACHE: return WIKI_CACHE[query]
    try:
        u = "https://en.wikipedia.org/w/api.php?" + urllib.parse.urlencode(
            {"action":"query","list":"search","srsearch":query,"format":"json","srlimit":5})
        hits = _jget(u).get("query", {}).get("search", [])
        if not hits: WIKI_CACHE[query] = None; return None
        ql = query.lower().strip()
        title = next((h["title"] for h in hits if ql in h["title"].lower()), hits[0]["title"])
        e = "https://en.wikipedia.org/w/api.php?" + urllib.parse.urlencode(
            {"action":"query","prop":"extracts","exintro":1,"explaintext":1,
             "titles":title,"format":"json"})
        page = next(iter(_jget(e)["query"]["pages"].values()))
        ext = _clean(page.get("extract", ""))
        if not ext: WIKI_CACHE[query] = None; return None
        first = re.split(r"(?<=[.!?]) ", ext)[0]
        out = {"title": title, "extract": first}
        WIKI_CACHE[query] = out; return out
    except Exception:
        WIKI_CACHE[query] = None; return None

def _qid(title):
    try:
        u = "https://en.wikipedia.org/w/api.php?" + urllib.parse.urlencode(
            {"action":"query","prop":"pageprops","titles":title,"format":"json"})
        page = next(iter(_jget(u)["query"]["pages"].values()))
        return page.get("pageprops", {}).get("wikibase_item")
    except Exception: return None

def _wdp(qid, prop):
    q = ("SELECT ?vLabel WHERE { wd:%s wdt:%s ?v. "
         "SERVICE wikibase:label { bd:serviceParam wikibase:language \"en\". } } LIMIT 1"
         % (qid, prop))
    u = "https://query.wikidata.org/sparql?" + urllib.parse.urlencode({"query": q, "format": "json"})
    try:
        d = _jget(u, 12, is_sparql=True)
        r = d.get("results", {}).get("bindings", [])
        return r[0].get("vLabel", {}).get("value") if r else None
    except Exception: return None

def wd(title, attr):
    q = _qid(title)
    if not q: return None
    p = WDPROPS.get(attr)
    return _wdp(q, p) if p else None

def detect_attribute(text):
    q = text.lower()
    for a in WDPROPS:
        if re.search(r"\b" + re.escape(a) + r"\b", q): return a
    return None

