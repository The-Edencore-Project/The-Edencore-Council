# --- ORCHESTRATION: SERIAL RUNNER ---
def run_serial(prompts_by_seat, on_complete, gap=1.0):
    results = {}
    lst = list(prompts_by_seat.keys())
    for s in lst:
        redraw(s); glow_ritual(s, True)
        SEAT_MSGS[s].config(text="...", fg="#4a5a7a")
    def worker():
        for i, seat in enumerate(lst):
            try:
                r = prompts_by_seat[seat]()
                if r is None: r = "[no reply]"
            except Exception as e:
                r = "[error] %s: %s" % (type(e).__name__, str(e)[:120])
            results[seat] = r
            def show(seat=seat, r=r):
                COUNCIL.seats[seat].work(1.0)
                glow_ritual(seat, False)
                typewriter(seat, r)
            root.after(0, show)
            if i < len(lst) - 1: time.sleep(gap)
        root.after(0, lambda: on_complete(results))
    threading.Thread(target=worker, daemon=True).start()

def transcript_from(results, order=None):
    order = order or NAMES
    return "\n".join(s + ": " + results[s] for s in order if results.get(s))

# --- ORCHESTRATION: FACT PATH (WIKIPEDIA) ---
def fact_path(question, query):
    IN_DISCUSSION[0] = True
    attr = detect_attribute(question)
    def solon_prompt():
        if gemini_on() and WORKING_MODEL[0]:
            r = gemini_for_seat("Solon", question)
            if r and not r.startswith("[gemini error]"): return r
        return "\u2020 The channel is severed. Prism holds the archive."
    def prism_prompt():
        data = wiki(query)
        if data and attr:
            v = wd(data["title"], attr)
            if v: return "%s — %s\n  [%s \u00b7 Wikidata]" % (attr.capitalize(), v, data["title"])
        if data: return data["extract"] + "\n  [" + data["title"] + "]"
        return "The archive has nothing on that."
    prompts = {"Solon": solon_prompt, "Prism": prism_prompt}
    update_tier("\u2609 consulting the archive")
    def done(r):
        redraw(None); update_tier(None); COUNCIL.save()
        IN_DISCUSSION[0] = False
    run_serial(prompts, done, gap=0.6)

# --- ORCHESTRATION: FULL DISCUSSION ---
def start_discussion(question, kind, topic, seats_filter=None):
    IN_DISCUSSION[0] = True
    target_seats = list(seats_filter) if seats_filter else list(NAMES)
    def r1_prompt(seat): return lambda: seat_reply(seat, kind, question, topic)
    def after_round1(results):
        redraw(None)
        COUNCIL.rapport = min(1.0, MEMORY.msgs/200.0 + len(MEMORY.days)/30.0)
        if len(target_seats) >= 4 and kind not in ("greeting","greeting_morning","greeting_afternoon","greeting_evening","thanks","apology","local","weather","math","council","sys_check"):
            after_types_done(lambda: run_crosstalk(question, kind, results, target_seats))
        else:
            IN_DISCUSSION[0] = False
            update_tier(None); COUNCIL.save()
    r1 = {s: r1_prompt(s) for s in target_seats}
    update_tier("\u2629 the council is convened")
    run_serial(r1, after_round1, gap=0.4)

def run_crosstalk(question, kind, r1, target_seats):
    order = list(target_seats); pairs = []
    for i, seat in enumerate(order): pairs.append((seat, order[i-1]))
    prompts = {seat: (lambda s=seat: expert_crosstalk(s)) for seat, prev in pairs}
    def after_round2(r2):
        redraw(None)
        after_types_done(lambda: run_conclusion(question, r1, r2, target_seats))
    update_tier("\u26b9 the chamber answers")
    if not prompts: after_round2({}); return
    run_serial(prompts, after_round2, gap=0.4)

def run_conclusion(question, r1, r2, target_seats):
    update_tier("\u269c the verdict")
    if SEAT_ENGINE.get("Solon") == "gemini" and gemini_on():
        full = transcript_from(r1, target_seats)
        if r2: full += "\n\n---\n" + transcript_from(r2, target_seats)
        glow_ritual("Solon", True)
        SEAT_MSGS["Solon"].config(text="...", fg="#4a5a7a")
        def work():
            try: verdict = gemini_conclusion(question, full)
            except Exception as e: verdict = "[error] %s" % type(e).__name__
            def show():
                glow_ritual("Solon", False)
                typewriter("Solon", "\u2627 " + verdict,
                           done=lambda: (redraw(None), update_tier(None), COUNCIL.save(),
                                          IN_DISCUSSION.__setitem__(0, False),
                                          after_types_done(lambda: run_followup(target_seats))))
            root.after(0, show)
        threading.Thread(target=work, daemon=True).start()
    else:
        def work():
            time.sleep(0.4); line = random.choice(CONCLUSION)
            def show():
                glow_ritual("Solon", False)
                typewriter("Solon", "\u2627 " + line,
                           done=lambda: (redraw(None), update_tier(None), COUNCIL.save(),
                                          IN_DISCUSSION.__setitem__(0, False),
                                          after_types_done(lambda: run_followup(target_seats))))
            root.after(0, show)
        threading.Thread(target=work, daemon=True).start()

def run_followup(target_seats):
    candidates = [s for s in target_seats if s in FOLLOWUPS]
    if not candidates: return
    seat = random.choice(candidates)
    q = random.choice(FOLLOWUPS[seat])
    if seat in SEAT_FRAMES:
        glow_ritual(seat, True)
        typewriter(seat, "\u2735 " + q, delay=45)
        root.after(900, lambda: glow_ritual(seat, False))

# --- ORCHESTRATION: FAST PARALLEL (Greetings, Weather, Math, Sys Check) ---
def fast_parallel(question, kind, topic, seats_filter=None):
    target_seats = list(seats_filter) if seats_filter else list(NAMES)
    def prompt(seat):
        def f():
            if kind == "weather":
                data = weather(topic)
                if data:
                    r = weather_seat(seat, data)
                    if r: return r
            if kind == "local": return topic
            if kind == "math": return _fmt(POOLS["math"][seat], topic)
            if kind == "sys_check":
                if seat == "Solon":
                    m = WORKING_MODEL[0] or CONFIG["tiers"]["frontier"].get("model") or "auto"
                    if gemini_on(): return "\u2696 The channel is open. Current model: " + m + "."
                    else: return "\u2020 The channel is severed. Prism holds the archive."
                return random.choice(["Noted.", "Standing by.", "Listening."])
            if seat == "Ripple":
                fact = ripple_fact(extract_topic_words(question))
                if fact: return fact
            if kind in POOLS:
                entries = _as_list(POOLS[kind].get(seat, POOLS["statement"][seat]))
                if entries: return _fmt(random.choice(entries), topic)
            return POOLS["statement"][seat]
        return f
    prompts = {s: prompt(s) for s in target_seats}
    update_tier("\u2726 answering")
    def done(results):
        redraw(None); update_tier(None); COUNCIL.save()
    run_serial(prompts, done, gap=0.2)

