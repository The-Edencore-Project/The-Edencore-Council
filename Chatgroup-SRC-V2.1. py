@dataclass
class Extero:
    start: float = field(default_factory=time.time)
    activity: float = field(default_factory=time.time)
    lengths: list = field(default_factory=list)
    def record(self, t):
        self.activity = time.time(); self.lengths.append(len(t)); self.lengths = self.lengths[-10:]
    def tod(self):
        h = datetime.datetime.now().hour
        if 5<=h<12: return "morning"
        if 12<=h<17: return "afternoon"
        if 17<=h<22: return "evening"
        return "night"
    def mins(self): return (time.time()-self.start)/60.0
    def tone(self):
        if not self.lengths: return "quiet"
        a = sum(self.lengths)/len(self.lengths)
        if a < 15: return "brief"
        if a < 60: return "measured"
        if a < 200: return "thinking"
        return "long-form"
    def summary(self):
        m = self.mins()
        ml = "just begun" if m < 1 else ("%dm" % int(m) if m < 60
              else "%dh %dm" % (int(m//60), int(m%60)))
        return "%s | %s | %s" % (self.tod(), ml, self.tone())

