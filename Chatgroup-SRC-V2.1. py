# --- MOOD & MEMORY HELPERS ---
MOOD_POS = {"good","great","happy","love","wonderful","brilliant","amazing","joy","glad",
            "thanks","appreciate","kind","warm","calm","hopeful","excited","grateful",
            "nice","lovely","perfect","awesome","fun","smile"}
MOOD_NEG = {"bad","terrible","awful","hate","angry","sad","horrible","miserable","upset",
            "worried","anxious","scared","afraid","tired","exhausted","frustrated",
            "annoyed","hurt","pain","dark","lonely","broken","lost","confused","wrong",
            "fail","dying","dead","cry","depressed","stress","hopeless"}
def analyse_mood(text):
    ws = re.findall(r"[a-z']+", text.lower())
    p = sum(1 for w in ws if w in MOOD_POS); n = sum(1 for w in ws if w in MOOD_NEG)
    if p + n == 0: return 0.0
    return (p - n) / float(p + n)

