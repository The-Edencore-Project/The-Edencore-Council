def discover_gemini_model():
    key = CONFIG["tiers"]["frontier"].get("key","").strip()
    if not key: return None
    try:
        url = "https://generativelanguage.googleapis.com/v1beta/models?key=" + key
        req = urllib.request.Request(url, headers={"Content-Type":"application/json"})
        with urllib.request.urlopen(req, timeout=15) as r:
            data = json.loads(r.read().decode())
        cands = []
        for m in data.get("models", []):
            name = m.get("name", "")
            methods = m.get("supportedGenerationMethods", [])
            if "generateContent" not in methods: continue
            if name.startswith("models/"): cands.append(name[len("models/"):])
        if not cands: DISCOVER_ERR[0] = "no capable models"; return None
        def rank(n):
            if "flash" in n and "8b" not in n and "thinking" not in n and "exp" not in n and "preview" not in n: return 0
            if "flash" in n and "thinking" not in n: return 1
            if "flash" in n: return 2
            if "pro" in n: return 3
            return 4
        cands.sort(key=rank); return cands[0]
    except Exception as e:
        DISCOVER_ERR[0] = "%s: %s" % (type(e).__name__, str(e)[:120]); return None

def _gemini_call(system_prompt, user_prompt, timeout=25, _retry=0):
    key = CONFIG["tiers"]["frontier"].get("key","").strip()
    if WORKING_MODEL[0] is None: WORKING_MODEL[0] = discover_gemini_model()
    if WORKING_MODEL[0] is None:
        return "[gemini error] " + (DISCOVER_ERR[0] or "no working model")
    if RATE_LIMITED[0] > 0:
        gap = time.time() - RATE_LIMITED[0]
        if gap < 6: time.sleep(6 - gap)
    model = WORKING_MODEL[0]
    url = ("https://generativelanguage.googleapis.com/v1beta/models/"
           + model + ":generateContent?key=" + key)
    body = json.dumps({
        "system_instruction": {"parts": [{"text": system_prompt}]},
        "contents": [{"role": "user", "parts": [{"text": user_prompt}]}],
        "generationConfig": {"temperature": 0.9, "maxOutputTokens": 500}
    }).encode()
    req = urllib.request.Request(url, data=body, method="POST",
                                 headers={"Content-Type":"application/json"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            data = json.loads(r.read().decode())
        RATE_LIMITED[0] = 0.0
        return data["candidates"][0]["content"]["parts"][0]["text"].strip()
    except urllib.error.HTTPError as e:
        try: err_body = e.read().decode()
        except Exception: err_body = ""
        if e.code == 404 and _retry < 1:
            m = re.search(r"use\s+models/([A-Za-z0-9\-\.]+)", err_body)
            if m:
                WORKING_MODEL[0] = m.group(1).strip()
                try:
                    CONFIG["tiers"]["frontier"]["model"] = WORKING_MODEL[0]
                    with open(CFG, "w") as f: json.dump(CONFIG, f, indent=2)
                except Exception: pass
                return _gemini_call(system_prompt, user_prompt, timeout, _retry+1)
        if e.code == 429 and _retry < 2:
            RATE_LIMITED[0] = time.time(); time.sleep(8 * (_retry + 1))
            return _gemini_call(system_prompt, user_prompt, timeout, _retry+1)
        return "[gemini error] HTTP %d %s | %s" % (e.code, e.reason, err_body[:200])
    except Exception as e:
        return "[gemini error] %s: %s" % (type(e).__name__, str(e)[:120])

def gemini_for_seat(seat, user_prompt): return _gemini_call(ROLE[seat], user_prompt)

def gemini_conclusion(question, transcript):
    sysp = ("You are Solon, presiding Chair of the Edencore Council. "
