def weather_seat(seat, w):
    if not w: return None
    n = w["name"] + (", " + w["country"] if w.get("country") else "")
    desc = WCODE.get(w.get("code"), "unclear")
    t, ti, tx, wi, pr = w.get("temp"), w.get("tmin"), w.get("tmax"), w.get("wind"), w.get("precip")
    if seat == "Solon":
        risks = []
        if pr and pr > 1: risks.append("rain")
        if wi and wi > 25: risks.append("wind")
        if t is not None and t < 3: risks.append("cold")
        return ("Risk noted: %s." % " and ".join(risks)) if risks else ("No risk named. %s. Proceed." % desc)
    if seat == "Lumen": return "A %s day in %s. What does it invite?" % (desc, n)
    if seat == "Vertex":
        parts = []
        if ti is not None and tx is not None: parts.append("%d to %dC" % (ti, tx))
        if wi is not None: parts.append("%dkm/h" % wi)
        return ", ".join(parts) + " in " + n + "."
    if seat == "Prism": return "%s — %s. A readable pattern." % (n, desc)
    if seat == "Ripple":
        if t is not None and t < 5: return "Cold. Take a coat, and think of those outside."
        if pr and pr > 1: return "Bring an umbrella. Softly."
        return "Nothing harsh. Go gently."
    return None

