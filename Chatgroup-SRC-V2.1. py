@dataclass
class Seat:
    stamina: float = 100.0; strain: float = 0.0; overwhelmed: bool = False
    def work(self, e=1.0):
        self.stamina = max(0.0, self.stamina - 2.2*e)
        self.strain = min(1.0, self.strain + 0.06*e)
        self.overwhelmed = self.stamina < 15.0
    def rest(self, dt):
        self.stamina = min(100.0, self.stamina + 0.17*dt)
        self.strain = max(0.0, self.strain - 0.020*dt)
        self.overwhelmed = self.stamina < 15.0

@dataclass
class Council:
    seats: dict = field(default_factory=dict); rapport: float = 0.0; last_save: float = 0.0
    def ensure(self):
        for n in NAMES:
            if n not in self.seats: self.seats[n] = Seat()
    def save(self):
        try:
            with open(BODY, "w") as f:
                json.dump({"saved_at": time.time(), "rapport": self.rapport,
                           "seats": {n: {"stamina": s.stamina, "strain": s.strain}
                                     for n, s in self.seats.items()}}, f)
        except Exception: pass
    def load(self):
        try:
            with open(BODY) as f: d = json.load(f)
        except Exception: return
        el = max(0.0, min(6.0, (time.time() - d.get("saved_at", time.time()))/3600.0))
        self.rapport = float(d.get("rapport", 0.0))
        for n in NAMES:
            sd = d.get("seats", {}).get(n)
            if sd:
                self.seats[n] = Seat(stamina=min(100.0, sd.get("stamina",100.0)+el*20.0),
                                     strain=max(0.0, sd.get("strain",0.0)-el*0.3))
            else: self.seats[n] = Seat()

