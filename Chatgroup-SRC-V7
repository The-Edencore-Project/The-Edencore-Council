# =====================================================================
# HEARTBEAT
# ---------------------------------------------------------------------
# Runs every 1 second. V7 sub-rhythms (V7-P07) layered on top:
#
#   - Every 30-60s, one seat breathes (subtle ambient glow)
#   - Solon's consideration timer runs before verdicts (in run_serial)
#   - Idle remarks become a slow drumbeat (already present, now
#     spaced more gently)
#
# Erosion decay (V7-P06) also runs here.
# =====================================================================

LAST_BREATHE = {"seat": None, "at": 0.0}


def heartbeat():
    # Recover stamina, decay strain
    for b in COUNCIL.seats.values():
        b.rest(1.0)

    # V7-P06: erosion decay
    decay_wear(1.0)

    # Rapport grows with messages and days
    COUNCIL.rapport = min(1.0,
                          MEMORY.msgs/200.0 + len(MEMORY.days)/30.0)

    # Update header
    update_ex()
    update_mood()
    poll_bat()

    now = time.time()

    # Periodic save
    if now - COUNCIL.last_save > 30:
        COUNCIL.save()
        COUNCIL.last_save = now

    # WATCHDOG: force release if a discussion hangs
    if IN_DISCUSSION[0] and (now - LAST_DISCUSSION_START[0] > 30):
        IN_DISCUSSION[0] = False
        add_system("\u2696 Solon - The council session timed out. "
                   "The floor is open.")

    # V7-P07: ambient breathe sub-rhythm
    # Every 30-60s, one seat glows faintly.
    # Skips if the council is actively speaking.
    if not IN_DISCUSSION[0] and (now - LAST_BREATHE["at"]) > 40:
        if random.random() < 0.15:  # only sometimes, not every tick
            seat = random.choice(NAMES)
            def do_breathe(s=seat):
                breathe_glow(s, intensity=0.25)
            root.after(0, do_breathe)
            LAST_BREATHE["seat"] = seat
            LAST_BREATHE["at"] = now

    # Idle remarks after 45s of user silence
    if (now - EXTERO.activity > 45
            and now - IDLE["last"] > 60
            and not IN_DISCUSSION[0]
            and entry.get().strip() == ""):
        idle_remark()
        IDLE["last"] = now

    root.after(1000, heartbeat)


