def run_ritual(name, on_complete=None):
    """Execute a named ritual wave in the background."""
    ritual = RITUALS.get(name)
    if not ritual:
        if on_complete: root.after(0, on_complete)
        return

    def worker():
        for i, seat in enumerate(ritual["order"]):
            line = ritual["lines"].get(seat, "")
            timing = ritual["timing"][i]
            if timing > 0: time.sleep(timing)
            def show(s=seat, l=line):
                glow_ritual(s, True)
                speed = SPEECH_PROFILE.get(s, {}).get("type_speed", 55)
                # Rituals are a touch faster than normal speech
                speed = max(20, int(speed * 0.7))
                typewriter(s, l, delay=speed)
                root.after(500, lambda: glow_ritual(s, False))
            root.after(0, show)
        time.sleep(1.0)
        if on_complete: root.after(0, on_complete)

    threading.Thread(target=worker, daemon=True).start()


