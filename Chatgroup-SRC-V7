# ORCHESTRATION: RUN SERIAL
# ---------------------------------------------------------------------
# Pauses are drawn from SPEECH_PROFILE so each seat's cadence is
# honoured. Solon speaks after a beat. Vertex snaps in. Ripple
# lingers. The chamber has rhythm.
# =====================================================================

def run_serial(prompts_by_seat, on_complete, gap=None, clear_first=False):
    """Run each seat's prompt in sequence with typewriter animation."""
    if clear_first:
        clear_all()

    results = {}
    lst = list(prompts_by_seat.keys())

    for s in lst:
        redraw(s)
        glow_ritual(s, True)

    def worker():
        for i, seat in enumerate(lst):
            # Pause before this seat speaks (V7-P03 cadence)
            pause = SPEECH_PROFILE.get(seat, {}).get("pause_before", 0.5)
            if i > 0 and pause > 0:
                time.sleep(min(pause, 1.8))

            try:
                r = prompts_by_seat[seat]()
                if r is None: r = "[no reply]"
            except Exception as e:
                r = "[error] %s: %s" % (type(e).__name__, str(e)[:120])
            results[seat] = r

            def show(seat=seat, r=r):
                COUNCIL.seats[seat].work(1.0)
                glow_ritual(seat, False)
                speed = SPEECH_PROFILE.get(seat, {}).get("type_speed", 45)
                typewriter(seat, r, delay=speed)

            root.after(0, show)

            # Gap between seats if no explicit pause (fallback)
            if gap is not None and i < len(lst) - 1:
                time.sleep(gap)

        root.after(0, lambda: on_complete(results))

    threading.Thread(target=worker, daemon=True).start()


def transcript_from(results, order=None):
    order = order or NAMES
    return "\n".join(s + ": " + results[s]
                     for s in order if results.get(s))


