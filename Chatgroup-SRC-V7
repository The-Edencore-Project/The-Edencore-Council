def send(event=None):
    raw = entry.get().strip()
    if not raw: return

    # Input lock with emergency escape
    if IN_DISCUSSION[0]:
        if raw.lower() in ("wait", "stop", "cancel"):
            IN_DISCUSSION[0] = False
            add_system("\u2696 Solon - The floor is yielded. Continue.")
            entry.delete(0, tk.END)
            return
        else:
            add_system("\u2696 Solon - The council is still speaking. "
                       "Say 'wait' to interrupt.")
            return

    entry.delete(0, tk.END)
    user_lab.config(text="You: " + raw)
    clear_all()
    SEND_COUNTER[0] += 1
    poll_bat()
    EXTERO.record(raw)
    MEMORY.msgs += 1
    IDLE["last"] = 0

    if handle_profile_command(raw, raw):
        MEMORY.save()
        update_mood()
        return

    if FIRST_RUN and not FIRST_RUN_SHOWN[0]:
        t = raw.lower().strip()
        if t in {"skip", "0"}:
            PROFILE.consent_given = True
            PROFILE.save()
            add_system("\u2696 Solon - Unnamed. Nothing will be kept.")
            FIRST_RUN_SHOWN[0] = True
            MEMORY.save()
            update_mood()
            return
        if t in {"1", "2", "3", "4"}:
            PROFILE.set_level(int(t))
            add_system("\u2696 Solon - Level %s accepted. "
                       "The council may now remember you." % t)
            FIRST_RUN_SHOWN[0] = True
            MEMORY.save()
            update_mood()
            return

    target, text = detect_address(raw)
    kind, _, topic = classify(text)

    tone = EXTERO.tone()
    is_q = kind in ("fact","recommend","opinion","planning","weather",
                    "math","council","sys_check")
    PROFILE.note_message(
        raw, tone,
        topic if kind in ("fact","recommend","planning","opinion") else None,
        is_q)
    PROFILE.note_mood(analyse_mood(raw))
    update_mood()

    if target and not text:
        def _attn(s=target):
            entries = _as_list(POOLS["attention"].get(s, "Yes."))
            return random.choice(entries)
        def done(r):
            redraw(None)
            update_tier(None)
            update_mood()
        run_serial({target: _attn}, done)
        MEMORY.save()
        return

    seats = [target] if target else None

    if kind == "fact":
        fact_path(text, topic)
    elif kind == "council":
        start_discussion(text, kind, topic, seats)
    elif kind in {"greeting","greeting_morning","greeting_afternoon",
                  "greeting_evening","thanks","apology","local","weather",
                  "math","compliment","howareyou","capability","bored",
                  "joke","saysomething","sys_check"}:
        fast_parallel(text, kind, topic, seats)
        if kind in ("greeting","greeting_morning",
                    "greeting_afternoon","greeting_evening"):
            memory_callback()
    else:
        start_discussion(text, kind, topic, seats)

    MEMORY.save()


