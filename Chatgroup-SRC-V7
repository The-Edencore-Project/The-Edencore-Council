def extract_hooks(text):
    """Return a list of topics matched from the user's message.
    Order is preserved: the first hook is the primary topic."""
    words = re.findall(r"[a-z]+", text.lower())
    hooks = []
    seen = set()
    for w in words:
        if w in HOOK_MAP:
            topic = HOOK_MAP[w]
            if topic not in seen:
                hooks.append(topic)
                seen.add(topic)
    return hooks


def extract_topic_words(text):
    """Return a list of non-stopword tokens (for Ripple fact matching)."""
    return [w for w in re.findall(r"[a-z]+", text.lower())
            if w not in STOPWORDS and len(w) > 2]


def try_math(text):
    """Detect simple arithmetic expressions and return the result."""
    t = text.lower().strip().rstrip("?=.")
    cleaned = re.sub(r"[^0-9\+\-\*/\.\(\)\s]", "", t)
    if not cleaned.strip() or not re.search(r"[\+\-\*/]", cleaned):
        return None
    try:
        r = eval(cleaned, {"__builtins__": {}}, {})
        if isinstance(r, (int, float)):
            if isinstance(r, float) and r.is_integer(): r = int(r)
            return str(r)
    except Exception: pass
    return None


def _fmt(s, topic):
    """Safe format: replace {topic} in a phrase.
    Hardened against paste-corrupted braces, non-string inputs,
    and empty topics."""
    if not s: return ""
    if not isinstance(s, str): s = str(s)
    t = topic or "that"
    s = s.replace("\\{", "{").replace("\\}", "}")
    return s.replace("{topic}", t)


