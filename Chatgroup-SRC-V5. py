# =====================================================================
# STATE ENGINE: IDLE REMARKS
# ---------------------------------------------------------------------
# Every ~60 seconds of user silence, one seat says something quiet.
# This keeps the chamber alive without demanding attention.
#
# * NOTE: A seat who is "overwhelmed" (low stamina) uses the "tired"
#         pool instead of the "idle" pool.
# =====================================================================

IDLE = {"last": 0.0}


def idle_remark():
    seat = random.choice(NAMES)

    # Ripple might drop a fact instead
    if seat == "Ripple":
        fact = ripple_fact()
        if fact:
            typewriter(seat, "\u273f " + fact, delay=50)
            glow_ritual(seat, True)
            root.after(700, lambda: glow_ritual(seat, False))
            return

    # Otherwise, use the tired or idle pool
    line = (POOLS["tired"][seat] if COUNCIL.seats[seat].overwhelmed
            else POOLS["idle"][seat])
    entry_line = random.choice(_as_list(line))
    typewriter(seat, "\u263d " + entry_line, delay=50)
    glow_ritual(seat, True)
    root.after(700, lambda: glow_ritual(seat, False))


# =====================================================================
# HEARTBEAT
# ---------------------------------------------------------------------
# Runs every 1 second on the main thread. Responsible for:
#   - Recovering seat stamina
#   - Updating rapport
#   - Updating the header (EXTERO, Mood, Tier)
#   - Polling battery
#   - Saving state every 30 seconds
#   - WATCHDOG: forcibly releasing the input lock if a discussion has
#     been running longer than 30 seconds (V5 new — this fixes the
#     "freeze" bug from V4).
#   - Triggering idle remarks after 45s of user silence
# =====================================================================

def heartbeat():
    # Recover stamina, decay strain
    for b in COUNCIL.seats.values():
        b.rest(1.0)

    # Rapport grows with messages and days visited
    COUNCIL.rapport = min(1.0,
                          MEMORY.msgs/200.0 + len(MEMORY.days)/30.0)

    # Update header
    update_ex()
    update_mood()
    poll_bat()

    now = time.time()

    # Periodic save
    if now - COUNCIL.last_save > 30:
        COUNCIL.save()
        COUNCIL.last_save = now

    # --- WATCHDOG (V5 new) ---
    # If a discussion has been "in progress" for more than 30 seconds,
    # force-release the lock. This is what prevents the app from ever
    # freezing again.
    if IN_DISCUSSION[0] and (now - LAST_DISCUSSION_START[0] > 30):
        IN_DISCUSSION[0] = False
        add_system("\u2696 Solon - The council session timed out. "
                   "The floor is open.")

    # Idle remarks after 45s of user silence
    if (now - EXTERO.activity > 45
            and now - IDLE["last"] > 60
            and not IN_DISCUSSION[0]
            and entry.get().strip() == ""):
        idle_remark()
        IDLE["last"] = now

    root.after(1000, heartbeat)


# =====================================================================
# INITIALIZATION
# ---------------------------------------------------------------------
# Everything that runs once when the app starts.
# =====================================================================

# If the user is at Level 4, log this session on exit (next startup).
if PROFILE.level >= 4 and PROFILE.session_start:
    top = sorted(PROFILE.themes.items(), key=lambda kv: -kv[1])[:3]
    PROFILE.add_session_log_entry([k for k, v in top])

PROFILE.note_session_start()

root.update_idletasks()
redraw()
update_ex()
update_mood()
update_tier()
poll_bat()

# First run: ask for memory level
if FIRST_RUN and not PROFILE.consent_given:
    root.after(400, show_first_run)
else:
    # Returning user with a name: greet by name
    if PROFILE.level > 0 and PROFILE.name:
        root.after(300, lambda: typewriter(
            "Solon",
            "\u2696 %s. The council holds your name." % PROFILE.name))
    # Returning user with multiple visits: Ripple notes it
    if len(PROFILE.days_visited) > 1 and PROFILE.level >= 2:
        root.after(1800, lambda: typewriter(
            "Ripple",
            "\u273f You have been here on %d days." % len(PROFILE.days_visited)))

# Start the heartbeat
heartbeat()
entry.focus_set()
root.mainloop()


