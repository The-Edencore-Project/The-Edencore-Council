# =====================================================================
# KNOWLEDGE ENGINE: PHRASE & FACT SELECTION
# ---------------------------------------------------------------------
# Given a set of hooks and a seat, pick a phrase from TOPIC_MATRIX.
# Occasionally inject a fact from FACTS_DB instead (20% chance).
# Colour the fact with the seat's personality using SEMANTIC_LINKS.
# =====================================================================

def select_phrase(seat, hooks):
    """Weighted selection from TOPIC_MATRIX based on the extracted hooks."""
    if not hooks: return None, None
    # Primary hook is the first one; it wins the topic slot.
    topic = hooks[0]
    if topic and topic in TOPIC_MATRIX:
        pool = TOPIC_MATRIX[topic].get(seat, [])
        if pool:
            return random.choice(pool), topic
    # Fallback: try other hooks
    for alt in hooks[1:]:
        if alt in TOPIC_MATRIX:
            pool = TOPIC_MATRIX[alt].get(seat, [])
            if pool:
                return random.choice(pool), alt
    return None, None


def select_fact(topic, chance=0.20):
    """Return a random fact for the topic with the given probability."""
    if random.random() > chance: return None
    if topic and topic in FACTS_DB:
        pool = FACTS_DB[topic]
        if pool: return random.choice(pool)
    return None


def color_fact_with_personality(fact, seat):
    """Use SEMANTIC_LINKS to add the seat's personality to a hard fact."""
    words = re.findall(r"[a-z]+", fact.lower())
    linked = []
    for w in words:
        if w in SEMANTIC_LINKS:
            linked.extend(SEMANTIC_LINKS[w])
    if not linked: return fact
    suffix = {
        "Solon":  " Note the risk in that.",
        "Lumen":  " What does that mean?",
        "Vertex": " A system worth studying.",
        "Prism":  " The pattern is clear.",
        "Ripple": " Imagine how that must feel.",
    }.get(seat, "")
    return fact + suffix


# =====================================================================
# PROVIDER ENGINE: SEAT REPLY
# ---------------------------------------------------------------------
# The single entry point for generating one seat's spoken line.
# =====================================================================

def _as_list(x):
    if isinstance(x, str): return [x]
    return list(x)


def seat_reply(seat, kind, question, topic):
    """Return the line this seat would speak in response to the question."""
    # If the seat is exhausted, use the tired pool.
    if COUNCIL.seats[seat].overwhelmed:
        return random.choice(_as_list(POOLS["tired"][seat]))

    # Explicit council question
    if kind == "council":
        pool = POOLS["council"].get(seat, "Noted.")
        return _fmt(random.choice(_as_list(pool)), topic or "that")

    # System diagnostic
    if kind == "sys_check":
        if seat == "Solon":
            return "\u2696 The council runs on the archive. No channels are open."
        return random.choice(["Noted.", "Standing by.", "Listening."])

    # Extract hooks from the question and try the TOPIC_MATRIX
    hooks = extract_hooks(question)
    phrase, matched_topic = select_phrase(seat, hooks)
    if phrase:
        # 20% chance of injecting a hard fact instead
        fact = select_fact(matched_topic)
        if fact:
            return color_fact_with_personality(fact, seat)
        return phrase

    # Ripple's personal fact library
    if seat == "Ripple":
        fact = ripple_fact(extract_topic_words(question))
        if fact: return fact

    # Fall back to generic response pool
    pool = POOLS.get(kind) or POOLS["statement"]
    entries = _as_list(pool.get(seat, "Noted."))
    return _fmt(random.choice(entries), topic or "that")


# =====================================================================
# PROVIDER ENGINE: CROSSTALK (V5 NEW — REFLECTION-BASED)
# ---------------------------------------------------------------------
# V5 change: crosstalk is now reflective. Each seat comments on what
# the previous seat just said, rather than repeating a fixed phrase.
#
# > CONTEXT: In V4 the crosstalk pool was 4 lines per seat. Debates
#            felt identical after round 1. In V5, crosstalk references
#            the previous speaker's phrase directly, so it always
#            reads as a genuine rebuttal or observation.
#
# How it works:
#   1. The crosstalk function receives the previous seat's line.
#   2. It extracts a key concept from that line.
#   3. It picks a reflection template for this seat.
#   4. It slots the concept into the template.
#
# Example:
#   Solon says: "Money is stored risk. Name your limit."
#   Lumen's crosstalk: "Risk noted. But what does 'limit' really mean?"
# =====================================================================

CROSSTALK_TEMPLATES = {
    "Lumen": [
        "{ref}. But what does that really mean?",
        "{ref}. I want the question, not the answer.",
        "You name {ref}. But who decides it?",
        "{ref}. There is something underneath that.",
    ],
    "Vertex": [
        "{ref}. Meaning aside, we still need a plan.",
        "{ref}. Structure it, and it will hold.",
        "{ref}. Nice thought. What is the first step?",
        "{ref}. Talk is fine. Build the smallest piece.",
    ],
    "Prism": [
        "{ref}. That is one thread in a larger pattern.",
        "{ref}. Everything connects to that.",
        "{ref}. The shape is forming.",
        "{ref}. Notice how it ties to the last thing said.",
    ],
    "Ripple": [
        "{ref}. And who is left out of that?",
        "{ref}. The quiet ones feel that too.",
        "{ref}. Kind, but is it kind enough?",
        "{ref}. Someone is missing from that thought.",
    ],
    "Solon": [
        "{ref}. Which is why the boundary must hold.",
        "{ref}. Useful. But name the risk first.",
        "{ref}. Edges first. Then the rest.",
        "{ref}. That is a boundary I would watch.",
    ],
}


def _extract_ref(previous_line):
    """Pull a short, quotable fragment from the previous speaker's line."""
    if not previous_line: return "that"
    # Take the first clause, cap it at a reasonable length
    first = re.split(r"[.;:!?]", previous_line)[0].strip()
    if len(first) > 45:
        first = first[:42].rstrip() + "..."
    return first or "that"


def expert_crosstalk(seat, previous_line=""):
    """Return a reflective crosstalk line for this seat."""
    # Ripple may occasionally drop a fact instead of a reflection
    if seat == "Ripple":
        fact = ripple_fact()
        if fact: return fact

    templates = CROSSTALK_TEMPLATES.get(seat, ["Noted."])
    ref = _extract_ref(previous_line)
    return random.choice(templates).replace("{ref}", ref)


