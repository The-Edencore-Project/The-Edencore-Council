# KNOWLEDGE ENGINE: EXTERNAL API HELPERS
# ---------------------------------------------------------------------
# Wikipedia, Wikidata, and Open-Meteo weather.
# These are the only network calls in the app.
#
# * NOTE: Every call has a timeout. If the network is down, the
#         functions return None, and the council falls back to
#         local knowledge. The app never freezes on the network.
# =====================================================================

def _jget(url, timeout=8, is_sparql=False):
    """JSON GET request with proper headers. Returns parsed JSON or raises."""
    headers = {"User-Agent": "EdencoreCouncil/1.0"}
    if is_sparql:
        headers["Accept"] = "application/sparql-results+json"
    req = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read().decode("utf-8"))


def _clean(t):
    return re.sub(r"\s+", " ", t).strip()


# Wikidata property mapping for common "what is X" questions
WDPROPS = {
    "population":"P1082","capital":"P36","height":"P2048","elevation":"P2044",
    "founded":"P571","born":"P569","died":"P570","country":"P17",
    "continent":"P30","length":"P2043","diameter":"P2386","area":"P2046",
    "currency":"P38","language":"P37","owner":"P127","leader":"P35"
}

WIKI_CACHE = {}


def wiki(query):
    """Look up a topic on Wikipedia. Returns {title, extract} or None."""
    if query in WIKI_CACHE: return WIKI_CACHE[query]
    try:
        u = "https://en.wikipedia.org/w/api.php?" + urllib.parse.urlencode(
            {"action":"query","list":"search","srsearch":query,
             "format":"json","srlimit":5})
        hits = _jget(u).get("query", {}).get("search", [])
        if not hits:
            WIKI_CACHE[query] = None
            return None
        ql = query.lower().strip()
        title = next((h["title"] for h in hits if ql in h["title"].lower()),
                     hits[0]["title"])
        e = "https://en.wikipedia.org/w/api.php?" + urllib.parse.urlencode(
            {"action":"query","prop":"extracts","exintro":1,"explaintext":1,
             "titles":title,"format":"json"})
        page = next(iter(_jget(e)["query"]["pages"].values()))
        ext = _clean(page.get("extract", ""))
        if not ext:
            WIKI_CACHE[query] = None
            return None
        first = re.split(r"(?<=[.!?]) ", ext)[0]
        out = {"title": title, "extract": first}
        WIKI_CACHE[query] = out
        return out
    except Exception:
        WIKI_CACHE[query] = None
        return None


def _qid(title):
    """Get the Wikidata Q-ID for a Wikipedia title."""
    try:
        u = "https://en.wikipedia.org/w/api.php?" + urllib.parse.urlencode(
            {"action":"query","prop":"pageprops","titles":title,"format":"json"})
        page = next(iter(_jget(u)["query"]["pages"].values()))
        return page.get("pageprops", {}).get("wikibase_item")
    except Exception:
        return None


def _wdp(qid, prop):
    """Query a single property from Wikidata."""
    q = ("SELECT ?vLabel WHERE { wd:%s wdt:%s ?v. "
         "SERVICE wikibase:label { bd:serviceParam wikibase:language \"en\". } } LIMIT 1"
         % (qid, prop))
    u = "https://query.wikidata.org/sparql?" + urllib.parse.urlencode(
        {"query": q, "format": "json"})
    try:
        d = _jget(u, 12, is_sparql=True)
        r = d.get("results", {}).get("bindings", [])
        return r[0].get("vLabel", {}).get("value") if r else None
    except Exception:
        return None


def wd(title, attr):
    """Get a specific attribute (e.g., population) from Wikidata."""
    q = _qid(title)
    if not q: return None
    p = WDPROPS.get(attr)
    return _wdp(q, p) if p else None


def detect_attribute(text):
    """Detect which Wikidata attribute the user is asking about."""
    q = text.lower()
    for a in WDPROPS:
        if re.search(r"\b" + re.escape(a) + r"\b", q):
            return a
    return None


