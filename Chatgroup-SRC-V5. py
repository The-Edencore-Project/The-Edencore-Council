# =====================================================================
# PROFILE COMMANDS
# ---------------------------------------------------------------------
# Any user message that starts with one of these patterns is handled
# directly, without going through the council. This gives the user
# control over their own data.
# =====================================================================

def handle_profile_command(raw, text):
    t = text.lower().strip().rstrip("?!.")

    if t in {"privacy", "privacy notice", "show privacy"}:
        popup_text("Edencore Council - Privacy", PRIVACY_NOTICE.split("\n"))
        return True

    if t in {"what do you know about me", "profile",
             "show profile", "show my profile"}:
        popup_text("Edencore Council - Your Profile", PROFILE.readback())
        return True

    if t in {"forget me", "forget my name"}:
        PROFILE.forget_name()
        add_system("\u2696 Solon - The name is erased. You remain otherwise known.")
        return True

    if t in {"forget everything", "forget all", "delete my profile"}:
        path = PROFILE_PATH
        PROFILE.forget_everything()
        popup_text("Edencore Council", [
            "The file has been deleted:",
            path,
            "You are a stranger again. That is allowed."])
        return True

    if t in {"export profile", "export my profile"}:
        add_system("\u2696 Solon - The profile lives here: " + PROFILE_PATH)
        return True

    m = re.match(r"^(?:set\s+)?(?:profile\s+)?level\s+([0-4])$", t)
    if m:
        n = int(m.group(1))
        old = PROFILE.level
        PROFILE.set_level(n)
        add_system("\u2696 Solon - Memory level set to %d (was %d)." % (n, old))
        return True

    nm = detect_name(text)
    if nm:
        if PROFILE.level == 0:
            add_system("\u2696 Solon - You gave a name, but memory is at level 0. "
                       "Type 'set level 1' to let the council keep it.")
            return True
        if nm.lower() != (PROFILE.name or "").lower():
            if PROFILE.name:
                PROFILE.aliases.append(nm)
                if len(PROFILE.aliases) > 5:
                    PROFILE.aliases = PROFILE.aliases[-5:]
            else:
                PROFILE.name = nm
            PROFILE.save()
            add_system("\u2696 Solon - Noted. %s." % nm)
            return True
    return False


