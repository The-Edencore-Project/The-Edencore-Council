# =====================================================================
# ORCHESTRATION STATE FLAGS
# ---------------------------------------------------------------------
# IN_DISCUSSION    - True while the council is speaking. Blocks new input.
# LAST_DISCUSSION_START - Timestamp of the current discussion, used by
#                         the watchdog to force-release if it hangs.
# =====================================================================

IN_DISCUSSION = [False]
LAST_DISCUSSION_START = [0.0]


# =====================================================================
# ORCHESTRATION: RUN SERIAL
# ---------------------------------------------------------------------
# Runs a set of prompts one at a time, in order, with typewriter
# animation. Used by all orchestration functions below.
#
# * NOTE: This runs in a background thread to avoid blocking the UI.
#         All UI updates are marshalled back to the main thread via
#         root.after(0, ...).
# =====================================================================

def run_serial(prompts_by_seat, on_complete, gap=1.0):
    """Run each seat's prompt in sequence, animating the responses."""
    results = {}
    lst = list(prompts_by_seat.keys())

    # Initial visual: glow each seat, show "..."
    for s in lst:
        redraw(s)
        glow_ritual(s, True)
        SEAT_MSGS[s].config(text="...", fg="#4a5a7a")

    def worker():
        for i, seat in enumerate(lst):
            try:
                r = prompts_by_seat[seat]()
                if r is None: r = "[no reply]"
            except Exception as e:
                r = "[error] %s: %s" % (type(e).__name__, str(e)[:120])
            results[seat] = r

            def show(seat=seat, r=r):
                COUNCIL.seats[seat].work(1.0)
                glow_ritual(seat, False)
                speed = SPEECH_PROFILE.get(seat, {}).get("type_speed", 40)
                typewriter(seat, r, delay=speed)

            root.after(0, show)
            if i < len(lst) - 1:
                time.sleep(gap)

        root.after(0, lambda: on_complete(results))

    threading.Thread(target=worker, daemon=True).start()


def transcript_from(results, order=None):
    """Build a text transcript from a results dict (used for context)."""
    order = order or NAMES
    return "\n".join(s + ": " + results[s]
                     for s in order if results.get(s))


# =====================================================================
# ORCHESTRATION: FACT PATH (WIKIPEDIA)
# ---------------------------------------------------------------------
# Triggered when the user asks a "who/what/where" question that looks
# like a fact lookup. Solon speaks first (framing the question), then
# Prism delivers the archive result.
#
# * NOTE: If the query has fewer than 3 real words, we skip Wikipedia
#         entirely and Prism says the archive has nothing. This
#         prevents random TV show articles from being returned.
# =====================================================================

def fact_path(question, query):
    IN_DISCUSSION[0] = True
    LAST_DISCUSSION_START[0] = time.time()
    attr = detect_attribute(question)

    def solon_prompt():
        return "\u2020 The channel is a reading room. Prism holds the archive."

    def prism_prompt():
        # V5 fix: sanity check the query length before searching
        words = [w for w in re.findall(r"[a-z]+", query.lower())
                 if w not in STOPWORDS and len(w) > 2]
        if len(words) < 3:
            return "The archive needs a clearer topic."
        data = wiki(query)
        if data and attr:
            v = wd(data["title"], attr)
            if v:
                return "%s - %s\n  [%s \u00b7 Wikidata]" % (
                    attr.capitalize(), v, data["title"])
        if data:
            return data["extract"] + "\n  [" + data["title"] + "]"
        return "The archive has nothing on that."

    prompts = {"Solon": solon_prompt, "Prism": prism_prompt}
    update_tier("\u2609 consulting the archive")

    def done(r):
        redraw(None)
        update_tier(None)
        COUNCIL.save()
        IN_DISCUSSION[0] = False

    run_serial(prompts, done, gap=0.6)


# =====================================================================
# ORCHESTRATION: FULL DISCUSSION
# ---------------------------------------------------------------------
# Triggered for statements, opinions, planning, and other substantial
# inputs. Runs Round 1 (all seats), then crosstalk, then a verdict.
#
# Optional hush ritual fires ~10% of the time before the debate.
# =====================================================================

def start_discussion(question, kind, topic, seats_filter=None):
    IN_DISCUSSION[0] = True
    LAST_DISCUSSION_START[0] = time.time()
    target_seats = list(seats_filter) if seats_filter else list(NAMES)

    def kickoff():
        def r1_prompt(seat):
            return lambda: seat_reply(seat, kind, question, topic)

        def after_round1(results):
            redraw(None)
            COUNCIL.rapport = min(1.0, MEMORY.msgs/200.0 + len(MEMORY.days)/30.0)
            # Only run crosstalk if we have a real discussion (4+ seats)
            # and the kind is a substantial one.
            skip_crosstalk_kinds = (
                "greeting","greeting_morning","greeting_afternoon",
                "greeting_evening","thanks","apology","local","weather",
                "math","council","sys_check"
            )
            if len(target_seats) >= 4 and kind not in skip_crosstalk_kinds:
                after_types_done(
                    lambda: run_crosstalk(question, kind, results, target_seats))
            else:
                IN_DISCUSSION[0] = False
                update_tier(None)
                COUNCIL.save()

        r1 = {s: r1_prompt(s) for s in target_seats}
        update_tier("\u2629 the council is convened")
        run_serial(r1, after_round1, gap=0.4)

    # Optional hush ritual (10% chance for 4+ seat discussions)
    if len(target_seats) >= 4 and random.random() < 0.10:
        run_ritual("hush", on_complete=kickoff)
    else:
        kickoff()


# =====================================================================
# ORCHESTRATION: CROSSTALK ROUND (V5 REFLECTION-BASED)
# ---------------------------------------------------------------------
# Each seat comments on the previous seat's line from round 1. This
# creates the illusion of dialogue instead of five parallel monologues.
# =====================================================================

def run_crosstalk(question, kind, r1, target_seats):
    """Run the crosstalk round. Each seat reflects on the previous speaker."""
    order = list(target_seats)
    prompts = {}
    for i, seat in enumerate(order):
        prev_seat = order[i-1]
        prev_line = r1.get(prev_seat, "")
        # Bind values via default args to avoid late-binding bug
        prompts[seat] = (
            lambda s=seat, pl=prev_line: expert_crosstalk(s, pl)
        )

    def after_round2(r2):
        redraw(None)
        after_types_done(
            lambda: run_conclusion(question, r1, r2, target_seats))

    update_tier("\u26b9 the chamber answers")
    if not prompts:
        after_round2({})
        return
    run_serial(prompts, after_round2, gap=0.4)


# =====================================================================
# ORCHESTRATION: CONCLUSION / VERDICT
# ---------------------------------------------------------------------
# V5 change: Solon always delivers a local verdict. No LLM is called.
# The verdict is chosen from the CONCLUSION pool.
# =====================================================================

def run_conclusion(question, r1, r2, target_seats):
    update_tier("\u269c the verdict")

    def work():
        time.sleep(0.4)
        line = random.choice(CONCLUSION)

        def show():
            glow_ritual("Solon", False)
            speed = SPEECH_PROFILE.get("Solon", {}).get("type_speed", 65)
            typewriter("Solon", "\u2627 " + line, delay=speed,
                       done=lambda: (
                           redraw(None),
                           update_tier(None),
                           COUNCIL.save(),
                           IN_DISCUSSION.__setitem__(0, False),
                           after_types_done(
                               lambda: run_followup(target_seats))))
        root.after(0, show)

    # Glow Solon as he prepares to speak
    glow_ritual("Solon", True)
    SEAT_MSGS["Solon"].config(text="...", fg="#4a5a7a")
    threading.Thread(target=work, daemon=True).start()


# =====================================================================
# ORCHESTRATION: FOLLOW-UP QUESTION
# ---------------------------------------------------------------------
# After a verdict, one seat (random) asks the user a follow-up
# question. This keeps the thread alive and encourages reflection.
#
# * NOTE: We keep the discussion lock on during the follow-up so the
#         user cannot interrupt mid-sentence. The watchdog will
#         release it after 30s if anything hangs.
# =====================================================================

def run_followup(target_seats):
    candidates = [s for s in target_seats if s in FOLLOWUPS]
    if not candidates: return

    # Hold the lock during the follow-up
    IN_DISCUSSION[0] = True
    LAST_DISCUSSION_START[0] = time.time()

    seat = random.choice(candidates)
    q = random.choice(FOLLOWUPS[seat])

    if seat in SEAT_FRAMES:
        glow_ritual(seat, True)
        speed = SPEECH_PROFILE.get(seat, {}).get("type_speed", 45)

        def release():
            redraw(None)
            update_tier(None)
            COUNCIL.save()
            IN_DISCUSSION[0] = False

        typewriter(seat, "\u2735 " + q, delay=speed, done=release)
        root.after(900, lambda: glow_ritual(seat, False))
    else:
        IN_DISCUSSION[0] = False


# =====================================================================
# ORCHESTRATION: FAST PARALLEL
# ---------------------------------------------------------------------
# Triggered for lightweight kinds: greetings, thanks, weather, math,
# system diagnostics. Short, quick responses from each seat. No
# crosstalk, no verdict.
# =====================================================================

def fast_parallel(question, kind, topic, seats_filter=None):
    target_seats = list(seats_filter) if seats_filter else list(NAMES)

    def prompt(seat):
        def f():
            # Weather: use the live API per seat
            if kind == "weather":
                data = weather(topic)
                if data:
                    r = weather_seat(seat, data)
                    if r: return r
            # Local time/date: the topic IS the answer string
            if kind == "local":
                return topic
            # Math: format the number in each seat's style
            if kind == "math":
                return _fmt(POOLS["math"][seat], topic)
            # System diagnostic
            if kind == "sys_check":
                if seat == "Solon":
                    return "\u2696 The council runs on the archive. No channels are open."
                return random.choice(["Noted.", "Standing by.", "Listening."])
            # Ripple may deliver a fact
            if seat == "Ripple":
                fact = ripple_fact(extract_topic_words(question))
                if fact: return fact
            # Standard pool lookup
            if kind in POOLS:
                entries = _as_list(POOLS[kind].get(seat, POOLS["statement"][seat]))
                if entries:
                    return _fmt(random.choice(entries), topic)
            return POOLS["statement"][seat]
        return f

    prompts = {s: prompt(s) for s in target_seats}
    update_tier("\u2726 answering")

    def done(results):
        redraw(None)
        update_tier(None)
        COUNCIL.save()

    run_serial(prompts, done, gap=0.2)


