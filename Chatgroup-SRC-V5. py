# =====================================================================
# GRAPHICS ENGINE: TYPEWRITER EFFECT
# ---------------------------------------------------------------------
# The typewriter effect reveals text one character at a time. Each
# seat has a different typing speed (see SPEECH_PROFILE).
#
# * NOTE: Only one typewriter can run per seat at a time. If a new
#         one starts, the previous one is cancelled.
# =====================================================================

TYPE_JOBS = {}

def typewriter(seat, full_text, done=None, delay=40):
    """Reveal text character by character in the seat's message box."""
    lbl = SEAT_MSGS.get(seat)
    if not lbl: return
    if seat in TYPE_JOBS:
        try: root.after_cancel(TYPE_JOBS[seat])
        except Exception: pass

    lbl.config(text="", fg="#d8e0ea")
    full_text = (full_text or "")[:600]
    n = len(full_text)

    def step(i):
        if i >= n:
            TYPE_JOBS.pop(seat, None)
            if done: done()
            return
        lbl.config(text=full_text[:i+1])
        TYPE_JOBS[seat] = root.after(delay, lambda: step(i+1))

    step(0)


def cancel_typewriters():
    """Cancel all running typewriters. Called before new responses."""
    for seat, jid in list(TYPE_JOBS.items()):
        try: root.after_cancel(jid)
        except Exception: pass
    TYPE_JOBS.clear()


def after_types_done(callback, timeout=8.0):
    """Wait until all typewriters finish, then call the callback.
    Times out after `timeout` seconds to prevent hangs."""
    my_token = SEND_COUNTER[0]
    start = time.time()
    def check():
        if SEND_COUNTER[0] != my_token: return
        if not TYPE_JOBS or (time.time() - start) > timeout:
            callback()
        else:
            root.after(150, check)
    root.after(150, check)


def glow_ritual(seat, on):
    """Animate the highlight border of a seat's frame."""
    f = SEAT_FRAMES.get(seat)
    if not f: return
    base = COLOR[seat]
    if on:
        steps = [(base, 1), (_light(base, 0.30), 2),
                 (_light(base, 0.55), 3), ("#ffffff", 3)]
    else:
        steps = [(_light(base, 0.55), 3), (_light(base, 0.30), 2), (base, 1)]

    def tick(k):
        if k >= len(steps): return
        c, t = steps[k]
        try:
            f.config(highlightbackground=c, highlightthickness=t)
        except Exception: pass
        root.after(120, lambda: tick(k+1))
    tick(0)


def clear_all():
    """Clear all seat message areas and reset borders to default."""
    cancel_typewriters()
    for n in NAMES:
        SEAT_MSGS[n].config(text="", fg="#d8e0ec")
        f = SEAT_FRAMES.get(n)
        if f:
            f.config(highlightbackground=COLOR[n], highlightthickness=1)


def add_system(text):
    """Display a system message in Solon's box in gold.
    Used for profile confirmations, watchdog messages, and errors."""
    if len(text) > 200:
        popup_text("Edencore Council", text.split("\n"))
        return
    lbl = SEAT_MSGS.get("Solon")
    if not lbl: return
    cancel_typewriters()
    for n in NAMES:
        if n != "Solon":
            SEAT_MSGS[n].config(text="", fg="#d8e0ec")
    lbl.config(text=text[:600], fg=GOLD)


def popup_text(title, lines):
    """Open a modal popup window with the given title and lines."""
    win = tk.Toplevel(root)
    win.title(title)
    win.configure(bg=HALL)
    txt = tk.Text(win, bg=DEEP, fg=PARCH, font=F(5), wrap="word",
                  bd=0, padx=16, pady=12)
    txt.pack(fill="both", expand=True, padx=8, pady=8)
    txt.insert("1.0", "\n".join(lines))
    txt.config(state="disabled")
    tk.Button(win, text="close", bg="#5aa8ff", fg=DEEP, bd=0,
              font=F(5, True), command=win.destroy).pack(pady=(0, 8))
    win.transient(root)
    win.grab_set()


# =====================================================================
# PROTOCOL ENGINE: RITUALS & WAVES
# ---------------------------------------------------------------------
# A ritual is a named pattern of seats speaking in a specific order,
# with specific timings. The most famous is the "hush" ritual:
#
#     Solon: "Silence."  (immediate)
#     Lumen, Vertex, Prism: "Hush."  (in quick succession)
#     Ripple: "The floor is yours."  (after a beat)
#
# Rituals fire randomly (~10% chance) before a full council debate.
# They make the chamber feel alive.
# =====================================================================

RITUALS = {
    "hush": {
        "order": ["Solon", "Lumen", "Vertex", "Prism", "Ripple"],
        "timing": [0.0, 0.15, 0.15, 0.15, 0.40],
        "type_speed": 20,
        "lines": {
            "Solon":  "Silence.",
            "Lumen":  "Hush.",
            "Vertex": "Hush.",
            "Prism":  "Hush.",
            "Ripple": "The floor is yours.",
        }
    }
}


def run_ritual(name, on_complete=None):
    """Execute a named ritual wave. Runs in a background thread."""
    ritual = RITUALS.get(name)
    if not ritual:
        if on_complete: root.after(0, on_complete)
        return

    def worker():
        for i, seat in enumerate(ritual["order"]):
            line = ritual["lines"].get(seat, "")
            timing = ritual["timing"][i]
            if timing > 0: time.sleep(timing)
            def show(s=seat, l=line):
                glow_ritual(s, True)
                typewriter(s, l, delay=ritual["type_speed"])
                root.after(400, lambda: glow_ritual(s, False))
            root.after(0, show)
        time.sleep(1.2)
        if on_complete: root.after(0, on_complete)

    threading.Thread(target=worker, daemon=True).start()


