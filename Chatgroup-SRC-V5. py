# ---------------------------------------------------------------------
# Reads /sys/class/power_supply on Android/Linux.
# Polled once every 60 seconds in the heartbeat.
# =====================================================================

BAT = {"pct": None, "chg": False, "polled": 0.0}


def _bat():
    """Return (percentage, is_charging) or None if unavailable."""
    try:
        for d in os.listdir("/sys/class/power_supply"):
            p = "/sys/class/power_supply/" + d
            cp = os.path.join(p, "capacity")
            if not os.path.exists(cp): continue
            with open(cp) as f: pct = int(f.read().strip())
            chg = False
            st = os.path.join(p, "status")
            if os.path.exists(st):
                with open(st) as f:
                    chg = f.read().strip().lower() in ("charging","full")
            return pct, chg
    except Exception: pass
    return None


def poll_bat():
    """Poll battery if it has been more than 60 seconds."""
    if time.time() - BAT["polled"] < 60: return
    BAT["polled"] = time.time()
    r = _bat()
    if r:
        BAT["pct"], BAT["chg"] = r


