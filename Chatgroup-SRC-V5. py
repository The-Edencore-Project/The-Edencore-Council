# STATE ENGINE: MOOD MONITOR (V5 NEW)
# ---------------------------------------------------------------------
# The Mood Monitor produces a single word describing the emotional
# weather of the chamber. It is shown in the header, and it shifts
# based on the council's strain, the user's mood, and the rapport.
#
# Three dimensions:
#   mood    - emotional weather (contemplative, warm, somber, etc.)
#   strain  - the council's fatigue (low, moderate, high)
#   rapport - how well the council knows you (cool, steady, warm)
#
# * NOTE: This is deliberately approximate. We are not measuring
#         neurochemistry. We are giving the chamber a felt sense.
# =====================================================================

MOOD_STATES = [
    "contemplative", "warm", "somber", "curious",
    "restless", "steady", "fractious", "gentle",
]

def compute_mood():
    """Return a dict with the current mood, strain, and rapport labels."""
    # Average strain across the seats
    if not COUNCIL.seats: return {"mood": "steady", "strain": "low", "rapport": "cool"}
    avg_strain = sum(s.strain for s in COUNCIL.seats.values()) / len(COUNCIL.seats)

    # Rapport label
    r = COUNCIL.rapport
    if r < 0.2: rapport = "cool"
    elif r < 0.5: rapport = "steady"
    elif r < 0.8: rapport = "warm"
    else: rapport = "close"

    # Strain label
    if avg_strain < 0.2: strain = "low"
    elif avg_strain < 0.5: strain = "moderate"
    else: strain = "high"

    # Mood label - derived from user's recent mood and council strain
    user_mood = PROFILE.mood_ema if PROFILE.level >= 3 else 0.0
    if avg_strain > 0.6:
        mood = "restless"
    elif user_mood < -0.3:
        mood = "somber"
    elif user_mood > 0.3 and rapport in ("warm", "close"):
        mood = "warm"
    elif rapport == "close":
        mood = "gentle"
    elif avg_strain < 0.15 and rapport in ("cool", "steady"):
        mood = "steady"
    else:
        mood = "contemplative"

    return {"mood": mood, "strain": strain, "rapport": rapport}


