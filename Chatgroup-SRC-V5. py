# =====================================================================
# STATE ENGINE: MOOD ANALYSIS
# ---------------------------------------------------------------------
# Very simple sentiment analysis based on keyword matching. Returns
# a value between -1 (very negative) and +1 (very positive).
# Used by the Profile and by the Mood Monitor.
# =====================================================================

MOOD_POS = {
    "good","great","happy","love","wonderful","brilliant","amazing","joy","glad",
    "thanks","appreciate","kind","warm","calm","hopeful","excited","grateful",
    "nice","lovely","perfect","awesome","fun","smile"
}
MOOD_NEG = {
    "bad","terrible","awful","hate","angry","sad","horrible","miserable","upset",
    "worried","anxious","scared","afraid","tired","exhausted","frustrated",
    "annoyed","hurt","pain","dark","lonely","broken","lost","confused","wrong",
    "fail","dying","dead","cry","depressed","stress","hopeless"
}

def analyse_mood(text):
    ws = re.findall(r"[a-z']+", text.lower())
    p = sum(1 for w in ws if w in MOOD_POS)
    n = sum(1 for w in ws if w in MOOD_NEG)
    if p + n == 0: return 0.0
    return (p - n) / float(p + n)


def memory_callback():
    """After a greeting, occasionally reference the user's top theme."""
    if PROFILE.level < 2: return
    top = PROFILE.top_theme()
    if not top: return
    if len(PROFILE.days_visited) < 2: return

    seat = random.choice(["Prism", "Lumen", "Ripple"])
    line = {
        "Prism":  "\u262f You return to %s often. The pattern is forming." % top,
        "Lumen":  "\u0950 We never finished %s. Shall we?" % top,
        "Ripple": "\u273f You have come back to %s. That matters." % top,
    }[seat]

    def show():
        glow_ritual(seat, True)
        typewriter(seat, line, delay=45)
        root.after(900, lambda: glow_ritual(seat, False))

    root.after(2500, show)


# =====================================================================
# MAIN INPUT HANDLER
# ---------------------------------------------------------------------
# send() is the single entry point for user input. It:
#   1. Enforces the input lock (with emergency override).
#   2. Routes profile commands.
#   3. Classifies the message.
#   4. Updates Profile and Memory.
#   5. Dispatches to the correct orchestration function.
#
# V5 fix: the input lock is now hard. While the council is speaking,
#         typing is ignored UNLESS the user types "wait", "stop", or
#         "cancel" — which forcibly releases the lock.
# =====================================================================

def send(event=None):
    raw = entry.get().strip()
    if not raw: return

    # --- Input lock with emergency escape ---
    if IN_DISCUSSION[0]:
        if raw.lower() in ("wait", "stop", "cancel"):
            IN_DISCUSSION[0] = False
            add_system("\u2696 Solon - The floor is yielded. Continue.")
            entry.delete(0, tk.END)
            return
        else:
            add_system("\u2696 Solon - The council is still speaking. "
                       "Say 'wait' to interrupt.")
            return

    entry.delete(0, tk.END)
    user_lab.config(text="You: " + raw)
    clear_all()
    SEND_COUNTER[0] += 1
    poll_bat()
    EXTERO.record(raw)
    MEMORY.msgs += 1
    IDLE["last"] = 0

    # --- Profile commands first ---
    if handle_profile_command(raw, raw):
        MEMORY.save()
        update_mood()
        return

    # --- First-run memory level selection ---
    if FIRST_RUN and not FIRST_RUN_SHOWN[0]:
        t = raw.lower().strip()
        if t in {"skip", "0"}:
            PROFILE.consent_given = True
            PROFILE.save()
            add_system("\u2696 Solon - Unnamed. Nothing will be kept.")
            FIRST_RUN_SHOWN[0] = True
            MEMORY.save()
            update_mood()
            return
        if t in {"1", "2", "3", "4"}:
            PROFILE.set_level(int(t))
            add_system("\u2696 Solon - Level %s accepted. "
                       "The council may now remember you." % t)
            FIRST_RUN_SHOWN[0] = True
            MEMORY.save()
            update_mood()
            return

    # --- Address detection (e.g. "Solon, ...") ---
    target, text = detect_address(raw)
    kind, topic, _ = classify(text)

    # --- Update profile state ---
    tone = EXTERO.tone()
    is_q = kind in ("fact","recommend","opinion","planning","weather",
                    "math","council","sys_check")
    PROFILE.note_message(
        raw, tone,
        topic if kind in ("fact","recommend","planning","opinion") else None,
        is_q)
    PROFILE.note_mood(analyse_mood(raw))
    update_mood()

    # --- Direct address to a single seat ---
    if target and not text:
        def _attn(s=target):
            entries = _as_list(POOLS["attention"].get(s, "Yes."))
            return random.choice(entries)

        def done(r):
            redraw(None)
            update_tier(None)
            update_mood()

        run_serial({target: _attn}, done, gap=0.2)
        MEMORY.save()
        return

    seats = [target] if target else None

    # --- Dispatch based on intent ---
    if kind == "fact":
        fact_path(text, topic)
    elif kind == "council":
        start_discussion(text, kind, topic, seats)
    elif kind in {"greeting","greeting_morning","greeting_afternoon",
                  "greeting_evening","thanks","apology","local","weather",
                  "math","compliment","howareyou","capability","bored",
                  "joke","saysomething","sys_check"}:
        fast_parallel(text, kind, topic, seats)
        if kind in ("greeting","greeting_morning",
                    "greeting_afternoon","greeting_evening"):
            memory_callback()
    else:
        start_discussion(text, kind, topic, seats)

    MEMORY.save()


