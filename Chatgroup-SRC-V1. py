import tkinter as tk
import random

# ============================================================
# SCREEN
# ============================================================
root = tk.Tk()
root.title("Edencore Council — Live")
try:
    root.attributes("-fullscreen", True)
except tk.TclError:
    pass
root.update_idletasks()
W = root.winfo_screenwidth()
H = root.winfo_screenheight()
root.geometry(f"{W}x{H}+0+0")
S = min(W / 480.0, H / 800.0)

root.configure(bg="#0a0e1a")

# ============================================================
# THE FIVE FAKE LLMs
# ============================================================
LLMS = [
    {"name": "Solon",  "color": "#5aa8ff", "role": "Governor"},
    {"name": "Lumen",  "color": "#b090ff", "role": "Philosopher"},
    {"name": "Vertex", "color": "#5fd08a", "role": "Engineer"},
    {"name": "Prism",  "color": "#ffc857", "role": "Generalist"},
    {"name": "Ripple", "color": "#ff7ea8", "role": "Voice"},
]

RESPONSES = {
    "Solon": [
        "Before we commit to {topic}, I want a boundary check. Where do we stop?",
        "This touches {topic}. I'll flag it as a governance concern for now.",
        "{topic} could have downstream effects. I'd rather move carefully.",
        "Noted on {topic}. I'd want a second opinion before we act.",
        "I'm cautious about {topic}. Let's name the risks first.",
    ],
    "Lumen": [
        "There's a deeper question underneath {topic}. What do we actually value here?",
        "{topic} is interesting, but I'd ask — what would we be agreeing to?",
        "Let's sit with {topic} for a moment. What's the felt sense of it?",
        "The philosophy of {topic} matters more than the mechanics, I think.",
        "{topic}. I keep circling back to what it means, not what it does.",
    ],
    "Vertex": [
        "Technically, {topic} is feasible. It's a matter of implementation.",
        "I can sketch a structure for {topic} — modular, recursive, clean.",
        "{topic} needs a fractal architecture. Anything flat will break.",
        "Give me an afternoon and {topic} becomes a working prototype.",
        "The engineering answer to {topic}: build it small first, then scale.",
    ],
    "Prism": [
        "Broadly, {topic} connects to at least three other threads we've touched.",
        "Let me summarise: {topic} sits at the intersection of safety and design.",
        "{topic} can be read many ways. That's its strength and its weakness.",
        "I see the pattern — {topic} is one expression of a larger structure.",
        "If I step back, {topic} looks less like a problem, more like a doorway.",
    ],
    "Ripple": [
        "From lived experience — {topic} feels bigger than it sounds.",
